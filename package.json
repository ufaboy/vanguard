{
  "name": "iron-vanguard",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "npx --yes serve public -l 3000",
    "start": "npx --yes serve public -l 3000",
    "build": "npm run lint",
    "vendor": "node scripts/sync-vendor.mjs",
    "optimize-models": "node scripts/optimize-models.mjs",
    "lint": "node scripts/lint.mjs",
    "prerender": "node scripts/prerender-pages.mjs",
    "pack-bricks": "node scripts/pack-bricks.mjs",
    "benchmark:bricks": "node scripts/run-brick-benchmark.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "pages:dev": "npx wrangler pages dev public",
    "test:hangar": "node scripts/run-brick-benchmark.mjs --hangar",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.9",
    "ktx2-encoder": "0.6.0",
    "sharp": "0.35.5",
    "wrangler": "^4.158.0"
  }
}
