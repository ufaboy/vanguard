{
  "name": "battle-tank",
  "private": true,
  "version": "4.13.0",
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:site && pnpm dlx serve dist/site -l 3000",
    "editor": "pnpm dlx serve . -l 3002",
    "codex": "pnpm dlx serve . -l 3001",
    "start": "pnpm run build:site && pnpm dlx serve dist/site -l 3000",
    "build": "pnpm run lint && pnpm run build:site",
    "build:itch": "node scripts/build-itch.mjs",
    "build:md": "node scripts/build-markdown.mjs",
    "vendor": "node scripts/sync-vendor.mjs",
    "optimize-models": "node scripts/optimize-models.mjs",
    "lint": "node scripts/lint.mjs",
    "bake:maps": "node scripts/bake-map.mjs",
    "check:maps": "node scripts/bake-map.mjs --check",
    "test": "node --test \"tests/*.test.js\"",
    "pack-bricks": "node scripts/pack-bricks.mjs",
    "pack-concrete": "node scripts/pack-bricks.mjs concrete",
    "benchmark:bricks": "node scripts/browser-smoke.mjs bricks",
    "smoke": "node scripts/browser-smoke.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "pages:dev": "pnpm run build:site && pnpm exec wrangler pages dev dist/site",
    "test:garage": "node scripts/browser-smoke.mjs garage",
    "prepare": "git config core.hooksPath .githooks",
    "dev:site": "astro dev --root site --port 4321",
    "build:site": "astro build --root site"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "astro": "7.4.13",
    "draco3dgltf": "1.5.9",
    "ktx2-encoder": "0.6.0",
    "sharp": "0.35.5",
    "wrangler": "^4.158.0"
  }
}
