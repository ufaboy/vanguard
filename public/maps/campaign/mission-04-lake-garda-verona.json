  "design": {
    "enemySide": "north",
    "tacticalIdentity": "Three distinct north-south corridors — the curving Gardesana lakeshore road, the cypress-lined villa lanes, and Verona’s walled eastern avenue — converge on the southern HQ. Break through the lakeshore customs wall or the Roman Arena brick ring to flank howitzers and convoy escorts.",
    "reference": {
      "place": "Lake Garda eastern shore and Verona historic walls & Roman Arena, Italy",
      "kind": "real",
      "kept": [
        "Lake Garda water mass along the western edge with sandy coves and a harbour quay",
        "Gardesana lakeshore convoy road curving through lakeside villages",
        "Cypress rows and walled country villas between the lake and Verona",
        "Verona outer defensive walls and the Roman Arena hinted by a brick ring with axial gates"
      ],
      "simplified": [
        "Verona Arena is represented with the generic brick wall kit rather than a custom 3D landmark",
        "Adige River bends and surrounding Alpine foothills are omitted to keep the 40x40 arena readable",
        "Shore villages (Peschiera / Sirmione) are compressed into two lakeside clusters with a single harbour pier"
      ]
    },
