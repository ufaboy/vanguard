  "design": {
    "enemySide": "north",
    "tacticalIdentity": "A capital-district battle along the Axe Historique from the Arc de Triomphe to Place de la Concorde. The grand avenue is broken by the Rond-Point fountain island and war barricades, flanked by the wooded Jardins des Champs-Élysées and Grand Palais to the west, Haussmannian side streets to the east, and the Seine with three bridges leading to the Eiffel Tower on the Left Bank.",
    "reference": {
      "place": "Paris — Champs-Élysées (France)",
      "kind": "real",
      "kept": [
        "Axe Historique from Place Charles de Gaulle (Arc de Triomphe) down Avenue des Champs-Élysées to Place de la Concorde (Obelisk)",
        "Rond-Point des Champs-Élysées breaking the avenue into two segments",
        "Jardins des Champs-Élysées and Grand Palais / Petit Palais on the western flank",
        "Haussmannian blocks and Rue du Colisée side streets on the eastern flank",
        "The Seine with stone quays and three bridges (Pont de l'Alma, Pont Alexandre III, Pont de la Concorde) leading to the Eiffel Tower on the Left Bank"
      ],
      "simplified": [
        "Rotated so Place Charles de Gaulle is north (enemy entry) and Place de la Concorde is south (Allied HQ)",
        "Compressed the Left Bank / Champ de Mars and Eiffel Tower to the eastern edge across the Seine",
        "Merged smaller side streets between Avenue Foch and Rue du Faubourg Saint-Honoré into two flanking corridors"
      ]
    },
