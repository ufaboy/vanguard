  "design": {
    "chapter": 1,
    "TacticalIdentity": "An offset sunken railway cut bordered by an upper-west passenger platform, a lower-east goods shed, and crooked outer service tunnels that expose howitzer firing bays from the flank.",
    "EngagementRange": "Long diagonal and north-south sightlines down the offset trackbed contrasted with close-quarters flanking through the narrow west service tunnel and wide east coal siding.",
    "RetreatOptions": "Southeast bus forecourt loop, southwest station ramp, and staggered cross-platform underpasses at rows 8-9, 19-20, and 25-26.",
    "breaches": [
      {
        "name": "West platform artillery breach",
        "cells": [
