        },
        "end": {
          "row": 14,
          "col": 18
        },
        "purpose": "Shatter the brick floodgate bulkhead connecting the west-central sluice dam to the storm-surge barrier island."
      },
      {
        "name": "East lock-house bulkhead",
        "cells": [
          {
            "row": 14,
            "col": 23
          },
          {
            "row": 15,
            "col": 23
          }
        ],
        "start": {
          "row": 14,
          "col": 25
        },
        "end": {
          "row": 14,
          "col": 21
        },
        "purpose": "Breach the east lock-house brick wall to cross laterally between the storm-surge barrier island and the east-central lock causeway."
      }
    ],
    "reference": {
      "place": "Scheldt Delta Dams (Oosterscheldekering / Delta Works, Zeeland, Netherlands)",
      "kind": "real",
      "kept": [
        "Open estuary water basins flanking concrete storm-surge barrier piers and sluice causeways",
        "Coastal sand dune headland on the west and reclaimed grass polders with windbreaks on the east and south",
        "Dry bridge decks and lock control island connecting the northern approaches to the southern polders"
      ],
      "simplified": [
        "Compressed the multi-kilometer Oosterscheldekering and Veerse Gatdam into four north-south dry causeways across two estuary basins",
        "Merged auxiliary drainage canals and lock chambers into readable tactical chokepoints"
      ]
    }
