  "design": {
    "enemySide": "north",
    "tacticalIdentity": "A light assault across Brussels on a clear autumn day: leave the Grand-Place, cross the Parc de Bruxelles past the Royal Palace and storm the command post hidden behind the Cinquantenaire arch. Mostly light tanks; a heavy guard and a howitzer hold the arch.",
    "reference": {
      "place": "Brussels (Belgium)",
      "kind": "real",
      "kept": [
        "Grand-Place with the Gothic Town Hall and the Maison du Roi",
        "Manneken Pis on its street corner",
        "Galeries Royales Saint-Hubert and the Mont des Arts garden",
        "Royal Palace facing the Parc de Bruxelles across the Place des Palais",
        "Parc de Bruxelles with its railing, bosquets, Grand Bassin and two basins",
        "Rue Royale, Rue Ducale and Rue de la Loi with the EU quarter",
        "Cinquantenaire arch with its colonnades, the two museum halls and the park pond",
        "Atomium on its plaza",
        "Ixelles ponds"
      ],
      "simplified": [
        "Districts several kilometres apart are compressed into one strip from the Grand-Place (south) to the Cinquantenaire (north)",
        "The Atomium (Heysel, far north) stands beside the Cinquantenaire, and the Ixelles ponds sit east of the park",
        "There is no river or canal crossing: only ponds and basins"
      ]
    },
