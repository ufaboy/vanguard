  "design": {
    "enemySide": "north",
    "tacticalIdentity": "Hold the Remagen bank of the Rhine against counterattacks over three crossings that no single position can watch: the Ludendorff railway bridge, a western treadway through the floodplain wood, and an eastern treadway below the Erpeler Ley. Promenade villas, orchards and town gardens break the sightlines and hide ambush positions, so the defence has to rotate.",
    "reference": {
      "place": "Ludendorff Bridge, Remagen / Erpel, Germany (March 1945)",
      "kind": "real",
      "kept": [
        "Railway bridge with stone towers at both abutments",
        "Erpeler Ley basalt cliff with the railway running into it",
        "Erpel village and vineyards on the far bank",
        "Remagen town, riverside road and left-bank railway with the station"
      ],
      "simplified": [
        "Map rotated: the Rhine runs west-east, Erpel is north, Remagen south",
        "Rhine narrowed to five cells; the 400 m bridge spans five cells",
        "The rail tunnel is shown as an open rock cut that reaches the north edge",
        "Two treadway bridges added for route choice (built later, downstream, in reality)"
      ]
    },
