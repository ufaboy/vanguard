        },
        "end": {
          "row": 14,
          "col": 21
        },
        "purpose": "Shatter the brick divider between the west and east lock chambers to dodge Hydra MLRS rocket triangles laterally."
      },
      {
        "name": "North spillway gate",
        "cells": [
          {
            "row": 9,
            "col": 19
          },
          {
            "row": 9,
            "col": 20
          }
        ],
        "start": {
          "row": 11,
          "col": 19
        },
        "end": {
          "row": 7,
          "col": 19
        },
        "purpose": "Breach the northern spillway gate to close distance rapidly when Hydra enters its Phase 2 barrage."
      }
    ],
    "densityRevision": "Two asymmetric navigable flood channels flank a central lock island with three dry bridge decks, concrete lock-control bastions, coastal pine windbreaks, and destructible brick bulkheads—with open shoreline edges and no artificial perimeter wall."
