        },
        "end": {
          "row": 22,
          "col": 23
        },
        "purpose": "Break through the eastern turbine yard wall to flank howitzer and jammer escorts staging on the east lock deck."
      },
      {
        "name": "Central lock-chamber divider",
        "cells": [
          {
            "row": 14,
            "col": 19
          },
          {
            "row": 15,
            "col": 19
          }
        ],
        "start": {
