    "reference": {
      "place": "Montjuic Hill, Castle, Olympic Ring & Mediterranean Coast (Barcelona, Spain)",
      "kind": "real",
      "kept": [
        "Montjuic Castle and coastal artillery battery on the northern summit with concrete curtain walls and brick sally gate",
        "Mediterranean sea edge and rocky/sandy coves along the eastern flank without sealing the map",
        "Estadi Olimpic bowl, Palau Sant Jordi hall, and Calatrava communications tower at the Olympic Ring junction",
        "Pine and cypress hill parklands, Miramar terrace, and winding coastal access roads"
      ],
      "simplified": [
        "Compressed the broad Montjuic massif, Olympic plateau, and port cliffside into a 40x40 tactical sector",
        "Represented the Calatrava communications tower with a generic water/signal tower landmark and the Olympic Ring with modular 2-storey stadium blocks and ground markings until a Barcelona 3D landmark pack exists"
      ]
    }
