  "design": {
    "enemySide": "north",
    "tacticalIdentity": "A light defence of the Palace of Versailles in late spring: columns cross the park around the Grand Canal, the bosquets and the Trianon and must go around the palace to reach the HQ in the Marble Court. Each wave brings one new enemy kind: a sapper, a flamethrower and a stealth tank in the groves, a jammer, then a kamikaze.",
    "reference": {
      "place": "Palace and gardens of Versailles (France)",
      "kind": "real",
      "kept": [
        "Garden front of the palace with the south and north wings",
        "Parterre d'eau mirror pools on the terrace",
        "Latona fountain and parterre",
        "Tapis Vert (Royal Allee) leading to the Apollo fountain",
        "Cross-shaped Grand Canal with no bridges",
        "Bosquets with the Colonnade, the Ballroom and the Queen's grove",
        "Orangerie and the Piece d'eau des Suisses",
        "Neptune basin and the north parterre",
        "Grand Trianon, Petit Trianon and the Queen's Hamlet pond",
        "Marble Court with the ministers' wings and the Louis XIV statue"
      ],
      "simplified": [
        "Map rotated 90 degrees: the Grand Canal (real west) is north, the palace and town (real east) south",
        "The park is compressed: the canal is short and the Trianon stands beside its end",
        "The town of Versailles is reduced to the stables and a few blocks behind the palace"
      ]
    },
