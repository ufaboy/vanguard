  "design": {
    "enemySide": "north",
    "tacticalIdentity": "A light second battle in a beautiful, intact Berlin: columns come out of the Tiergarten woods past the Victory Column and the Reichstag toward the Brandenburg Gate and Unter den Linden. The Gate splits the direct road into three passages, the woods and Ministergaerten give a covered west detour, and the embassy courtyards open an east shortcut.",
    "reference": {
      "place": "Brandenburg Gate and the Tiergarten, Berlin (Germany)",
      "kind": "real",
      "kept": [
        "Brandenburg Gate with the Quadriga between Platz des 18. Maerz and Pariser Platz",
        "Strasse des 17. Juni running straight through the Tiergarten to the Grosser Stern",
        "Victory Column on the Grosser Stern roundabout",
        "Neuer See lakes in the Tiergarten woods",
        "Reichstag with the Platz der Republik lawn",
        "Soviet War Memorial beside the avenue",
        "Pariser Platz frame: Adlon, embassies, Haus Liebermann and Haus Sommer",
        "Unter den Linden with its lime-tree promenade"
      ],
      "simplified": [
        "Map rotated 90 degrees: the Tiergarten (real west) is north, the Reichstag (real north) is east",
        "The Spree and the Holocaust Memorial are left out; the Reichstag has no dome",
        "Distances are compressed: the Victory Column stands much closer to the Gate",
        "Unter den Linden ends at the southern edge, where the HQ stands"
      ]
    },
