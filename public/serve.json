{
  "cleanUrls": true,
  "headers": [
    {
      "source": "{vendor,images,audio}/**",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "{src,maps,models}/**",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
