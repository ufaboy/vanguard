---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("privacy-policy");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Privacy Policy",
        "item": "https://battletank.online/privacy-policy"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="privacy-policy"
  title={"Privacy Policy — BATTLE TANK"}
  description={"Privacy Policy for BATTLE TANK: local browser storage for game saves and preferences, static hosting logs, and third-party links."}
  twitterDescription={"Privacy Policy for BATTLE TANK: local browser storage and static hosting details."}
  jsonLd={jsonLd}
  bodyPage="privacy-policy"
  script="src/pages/privacy-policy.js"
>
        <h1 class="menu-page-title" tabindex="-1">{t("Privacy Policy")}</h1>
        
    <p class="menu-lead">{t("BATTLE TANK is designed to run directly in your web browser without player accounts, logins, or personal profile collection.")}</p>
    <div class="menu-policy">
      <section>
        <h2>{t("1. Local Browser Storage")}</h2>
        <p>{t("To save your game progress and preferences between sessions, BATTLE TANK stores data locally on your device using browser storage (")}<code>{t("localStorage")}</code> {t("and")} <code>{t("sessionStorage")}</code>{t("). This data stays on your device and is not transmitted to us:")}</p>
        <ul>
          <li>{t("Campaign mission unlocks, contract completions, credits, and survival high scores.")}</li>
          <li>{t("Tank loadout, 5-track component upgrade tiers, and equipped optional modules (")}<code>{t("battle_tank_tank_config")}</code> {t("and save repository keys).")}</li>
          <li>{t("Audio, camera preset, graphics quality, and FPS cap preferences (")}<code>{t("battle_tank_settings")}</code>).</li>
        </ul>
        <p style="margin-top:10px;">{t("You can delete all locally saved data at any time by clearing site data in your browser settings.")}</p>
      </section>
      <section>
        <h2>{t("2. Server &amp; Hosting Logs")}</h2>
        <p>{t("BATTLE TANK is served as a static web application. Like standard web hosting providers, our hosting infrastructure (Cloudflare Pages) may automatically process basic technical request metadata—such as IP address, browser user-agent, requested URL, and timestamp—for security, DDoS protection, and reliable delivery.")}</p>
      </section>
      <section>
        <h2>{t("3. Advertising, Cookies &amp; Third-Party Vendors")}</h2>
        <p>{t("BATTLE TANK uses")} <strong>{t("Google AdSense")}</strong> {t("and")} <strong>{t("Google H5 Games Ads")}</strong> {t("to display advertisements (such as optional rewarded video ads and between-mission ad breaks). Third-party vendors, including Google, use cookies or local device identifiers to serve ads based on a user’s prior visits to this website or other websites.")}</p>
        <ul>
          <li>{t("Google’s use of advertising cookies enables it and its partners to serve ads based on your visit to BATTLE TANK and/or other sites on the Internet.")}</li>
          <li>{t("You may opt out of personalized advertising by visiting")} <a href="https://adssettings.google.com/" target="_blank" rel="noopener noreferrer">{t("Google Ads Settings")}</a>.</li>
          <li>{t("You can learn more about how Google processes data on partner sites in")} <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">{t("Google’s Privacy &amp; Terms")}</a>.</li>
        </ul>
        <p style="margin-top:10px;">{t("Pages may also link to external platforms such as GitHub for source code or issue reporting; any external website you visit is governed by its own privacy policy.")}</p>
      </section>
      <section>
        <h2>{t("4. Children’s Privacy")}</h2>
        <p>{t("We do not knowingly collect personally identifiable information from anyone, including children under 13, because the game operates without accounts, forms, or personal data collection.")}</p>
      </section>
      <section>
        <h2>{t("5. Policy Updates &amp; Contact")}</h2>
        <p>{t("If this policy changes in the future (for example, if online leaderboards or optional analytics are introduced), this page will be updated accordingly. For any privacy questions, please visit our")} <a href={h("./contact")}>{t("Contact")}</a> {t("page.")}</p>
      </section>
    </div>

  <Fragment slot="noscript">
      <main style="max-width:720px;margin:48px auto;padding:24px;font-family:system-ui,sans-serif;color:#f8fafc;">
        <h1>{t("Privacy Policy — BATTLE TANK")}</h1>
        <p>{t("BATTLE TANK stores game saves and preferences locally in your browser via localStorage and does not require user accounts.")}</p>
      </main>
  </Fragment>
</PageLayout>
