---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("changelog");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Changelog",
        "item": "https://battletank.online/changelog"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="changelog"
  title={"Changelog &amp; Patch Notes — BATTLE TANK"}
  description={"Latest updates, balance patches, new bosses, and engineering improvements for BATTLE TANK 3D browser tank game."}
  ogDescription={"Latest updates, balance patches, and gameplay improvements for BATTLE TANK."}
  twitterDescription={"Release history and gameplay updates for BATTLE TANK 3D."}
  jsonLd={jsonLd}
  bodyPage="changelog"
  script="src/pages/how-to-play.js"
>
        <h1 class="menu-page-title" tabindex="-1">{t("Changelog &amp; Patch Notes")}</h1>
        <p class="menu-lead">
          {t("Release history, balance tuning, and new tactical features for BATTLE TANK.")}
        </p>

        <div class="menu-grid" style="margin-top:24px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.7.0 // CAMERA &amp; FPV")}</span>
            <strong>{t("Discrete 90° Camera Rotation &amp; Victory Shell FPV")}</strong>
            <p>{t("Added discrete 90-degree isometric camera rotation via Q/E keys and top HUD buttons with a synchronized camera-up radar minimap, moved Contract interactions to F, upgraded cannon shells to a 3D armor-piercing model, and enabled FPV chase camera tracking for predicted final victory shells.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.8 // HARD MODE FIX")}</span>
            <strong>{t("Fix Hard Mode ATGM Lock on Enemy HQ")}</strong>
            <p>{t("Fixed an issue where Enemy HQ tiles blocked line-of-sight checks to themselves, preventing ATGM launches at the Enemy HQ after clearing all enemy tanks in Hard Mode.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.7 // BALANCE TUNING")}</span>
            <strong>{t("Tier 3–5 Chassis Mass &amp; Speed Rebalance")}</strong>
            <p>{t("Reduced chassis mass and increased speed multipliers for CH3 Heavy Torsion, CH4 Active All-Terrain, and CH5 Grav-Hover tracks.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.6 // REPOSITORY CLEANUP")}</span>
            <strong>{t("Isolate Experimental Showcase Reel to Feature Branch")}</strong>
            <p>{t("Moved the experimental showcase reel and scripted engine hooks out of main into a dedicated feature branch.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.5 // 96PX ICON PADDING")}</span>
            <strong>{t("Full-Width 96x96 Tank Icon")}</strong>
            <p>{t("Removed horizontal inner padding from icon-96.png so the tank emblem fills the full 96x96 frame for sharper visibility in Google Search results.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.4 // FAVICON &amp; APP ICONS")}</span>
            <strong>{t("Hybrid Tank Favicons, Transparent Search Icon &amp; Touch Icons")}</strong>
            <p>{t("Replaced the rounded-box favicon with a transparent, high-contrast tank silhouette for browser tabs (icon.svg, favicon.ico, 48x48) and a detailed transparent tank emblem for Google Search and PWA (96x96, 192x192, 512x512), plus full-bleed maskable and Apple touch icons.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.3 // GAME DESCRIPTIONS &amp; DOCS CLEANUP")}</span>
            <strong>{t("38-Mission Campaign, Survival &amp; Contracts Copy Alignment")}</strong>
            <p>{t("Updated remaining outdated game descriptions (35 missions, 36x36 grid references) across the Battle City comparison page and its translations, README, demo, map registry, and achievement defaults to reflect the 38-mission 7-region campaign, 40x40 arenas, Survival modes, and all 7 Contracts.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.6.0 // AIR STRIKES, GARAGE &amp; TEST ARCHITECTURE")}</span>
            <strong>{t("Air Strike Concurrency, Garage Rename &amp; Contract-Based Test Suite")}</strong>
            <p>{t("Limited concurrent air strikes while keeping air drops and field repairs independent, slowed aircraft flybys, and decoupled the Tactical Recon Drone module. Renamed Hangar to Garage across the game, UI, static pages, and scripts, and refactored the test suite to verify formulas, mechanics, and invariants rather than hardcoded balance numbers or engine internals.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.5.2 // Z-FIGHTING &amp; SHIMMER FIX")}</span>
            <strong>{t("3D Landmarks, Terrain GLBs, HQ &amp; Bridge Z-Fighting Elimination")}</strong>
            <p>{t("Eliminated coplanar z-fighting and camera-motion shimmering across all 12 landmark GLB packs (including St. Stephen's Cathedral, Verona Arena, Colosseum, Eiffel Tower, and Barcelona Cathedral), terrain GLBs (brick, concrete, and modular buildings), procedural structures (Allied HQ, Enemy Stronghold, Concrete, Crates, Barrels, and Bridges), and landmark masonry mortar lines via fwidth antialiasing. Added scripts/check-zfighting.mjs to verify zero coplanar geometry conflicts across elements and surface combinations.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.5.1 // HARD MODE ATGM &amp; HQ RECON")}</span>
            <strong>{t("Hard Mode ATGM Seeker, 10-Cell HQ Recon &amp; Campaign Layout Polish")}</strong>
            <p>{t("Fixed Hard Mode ATGM targeting so missiles require a visible target at launch, fly to the target's last known position if sight is lost, re-acquire non-cloaked enemies within a 4-cell seeker radius (MISSILE.SEEK_RADIUS_CELLS), and detonate at the last known point if none are found. Added a 10-cell recon perimeter around the player's living HQ (ENEMY_VISIBILITY.HQ_RECON_RADIUS_CELLS) and refined the 3-column Campaign workspace flex sizing.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.5.0 // CAMPAIGN REGION MAPS &amp; HUD FIX")}</span>
            <strong>{t("3-Column Campaign Theater Maps &amp; Tank Silhouette Sync Fix")}</strong>
            <p>{t("Redesigned the Campaign page into a 3-column layout with pre-rendered tactical SVG region maps for all 7 European sectors (Italy, Alps, Bohemia & Saxony, Germany, Low Countries, France, and Pyrenees & Catalonia), interactive mission markers at real geographic coordinates, and dashed route lines alongside the mission briefing and recon photo. Fixed the bottom-left tank damage silhouette cache in the battle HUD so repaired component faults and armor panels update immediately.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.4.2 // SITE GUIDES &amp; CAMPAIGN DOCS")}</span>
            <strong>{t("Hard Mode, Tactical Recon Drone &amp; 38-Mission Campaign Docs")}</strong>
            <p>{t("Updated the How to Play, Destructible Terrain, Arsenal, Campaign, Walkthrough, About, and Home pages (plus all 4 localized editions) to document Hard Mode line-of-sight visibility, the Tactical Recon Drone (Key R, $1,200), and the full 38-mission Iron Road campaign.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.4.1 // EXTENDED PRELOADING &amp; MODULEPRELOAD")}</span>
            <strong>{t("Three.js Addons, Map JSONs, Priority Audio &amp; Engine Modulepreload")}</strong>
            <p>{t("Extended background HTTP-cache preloading on menu pages to include the Three.js GLTF/Draco/KTX2 addon module chain, all 46 map JSON files (prioritizing the selected mission), fortified enemy base defense turret GLBs, and priority combat audio files. Aligned SoundManager priority keys with actual audio assets and added modulepreload links in battlefield.html for critical engine modules.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.4.0 // PERFORMANCE &amp; FASTER BATTLEFIELD LOADING")}</span>
            <strong>{t("Background Asset Preloading, Performance Audit Fixes &amp; Clean Mission URLs")}</strong>
            <p>{t("Added silent low-priority HTTP-cache preloading on menu pages (Home, Campaign, Survival, and Contracts) after page load and idle to warm Three.js/Draco/Basis decoders, the player tank, terrain, and mission-specific enemy and landmark GLBs before entering Battlefield. Fixed memory leaks, reduced draw calls and CPU overhead, compressed world GLBs, and simplified Battlefield URLs to a single ?mission=campaign-01 parameter.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.3.0 // 3D CODEX LANDMARKS &amp; VISUAL OVERHAUL")}</span>
            <strong>{t("3D Codex Landmarks Tab, Realistic Monument Lighting &amp; Unified Fallback")}</strong>
            <p>{t("Added a dedicated LANDMARKS tab to the 3D Codex studio showcasing all 43 battlefield monuments with footprint, height, collision, and GLB pack telemetry, plus copyable text across Codex panels. Darkened overly bright stone/limestone/sandstone materials across Paris, Berlin, Versailles, Brussels, Rome, Vienna, Amsterdam, Alps, Italy, and Germany landmark packs, fixed water z-fighting on Manneken Pis, rebuilt ELYSEE_RUINED, SAGRADA_FAMILIA, BARCELONA_CATHEDRAL, MONTJUIC_CASTLE, NEUSCHWANSTEIN, and VERONA_ARENA with richer architectural detail, and replaced 40+ per-landmark code fallbacks with a single unified procedural fallback.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.2.0 // HARD MODE &amp; RECON DRONE")}</span>
            <strong>{t("Hard Mode Line-of-Sight Visibility &amp; Tactical Recon Drone")}</strong>
            <p>{t("Added a Hard Mode setting where enemy tanks outside your direct line of sight smoothly fade out behind obstacles while radar continues tracking nearby contacts unless jammed. Audited all terrain and structure types with an explicit blocksLineOfSight flag (structures like brick, concrete, houses, landmarks, and bases block vision; water towers, crates, barrels, and hedgehogs do not; forest limits visibility beyond 7.5m). Added the purchasable Tactical Recon Drone module (Key R / HUD button) that flies to the cursor and orbits in a 4-cell radius for 12s, revealing hidden and camouflaged enemies within 6 cells.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.1.6 // HOWITZER SHELLS &amp; MAP SUPPLY BOXES")}</span>
            <strong>{t("155mm Howitzer Shell 3D Model &amp; 8 Supply Crates Per Map")}</strong>
            <p>{t("Rebuilt the HOWITZER indirect-fire artillery shell with a detailed 155mm 3D model (ogive nose, brass fuze, HE warning band, copper driving band, boat-tail, and tracer glow) with parabolic arc pitch and rifled spin in both battlefield combat and the 3D Codex. Distributed 8 accessible supply BOX crates across all 39 campaign, contract, and survival maps that previously had fewer.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 4.1.0 // IRON ROAD CAMPAIGN & LANDMARKS")}</span>
            <strong>{t("38-Mission Campaign Maps, 3D Landmark Packs, Recon UI &amp; ATGM Steering")}</strong>
            <p>{t("Authored all 37 new Rome-to-Barcelona (The Iron Road) campaign maps, added 38 mission recon preview images, and built 7 Blender 3D landmark packs (Vienna, Amsterdam, Barcelona, Alps, Italy, Germany, and Rotterdam). Redesigned the Campaign page with an operation goal banner, clean 600×600 ISR recon view with EO-IR reticle, and larger briefing typography. Added ATGM landmark-avoidance steering and dynamic climb/dive FPV camera pitch.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.4.0 // MAP TOOLING")}</span>
            <strong>{t("Theme-Based Map Creation Workflow &amp; Editor Map Links")}</strong>
            <p>{t("Added a map creation workflow that turns a theme or a real place into a realistic, playable 40x40 battlefield draft with rules for road networks, buildings, water, vegetation, the war layer, and tactical routes. The dev map editor can now open any map file directly from its URL. The game no longer adds walls around the allied HQ on its own: every map now draws its HQ cover itself. Five new real-place maps are now operation contracts on the Contracts board: Charles Bridge in Prague, Brandenburg Gate in Berlin, Versailles, an assault on an enemy HQ in Brussels (with the Atomium, the Cinquantenaire arch, the Town Hall and Manneken Pis) and Remagen Bridgehead. Their story is still a placeholder, and campaign missions 1-5 are temporary placeholder fields until the campaign is rewritten.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.3.0 // MAP EDITOR &amp; TERRAIN POLISH")}</span>
            <strong>{t("3D Dev Map Editor, Oil Chain-Ignition &amp; Terrain Fixes")}</strong>
            <p>{t("Added a standalone 3D map editor outside the deployed game bundle for authoring 40x40 terrain layers, buildings, landmarks, decorations, and spawns. Fixed grass-to-road edge z-fighting, enabled burning oil slicks to chain-ignite adjacent layered oil cells and detonate barrels on burnout, and normalized empty ground tokens across all sector maps.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.2.0 // RADAR &amp; AIR SUPPORT")}</span>
            <strong>{t("Tactical Satellite Radar &amp; Off-Map Aircraft Approaches")}</strong>
            <p>{t("Redesigned the bottom-right radar with a live tactical terrain map, compass degree bezel, N/E/S/W badges, 500 m scale bar, turret FOV cone, and diamond-chevron contact markers. Strategic Bomber and AC-130 Spooky air support now fly in from outside the map perimeter and depart off-map after completing their mission.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.1.0 // CINEMATICS &amp; FPV")}</span>
            <strong>{t("Victory Orbit Camera &amp; Missile FPV Chase Cam")}</strong>
            <p>{t("Added a 3.2s victory cinematics sequence that zooms in on the final destroyed tank or Enemy HQ, orbits 360° around it, and triggers its explosion ~1s into the orbit before showing the results modal. Added an optional Missile FPV chase camera (HUD button and V key) with 0.75× slow motion, a 1s post-explosion hold, and tuned matte missile airframes with a bluish-scarlet nozzle exhaust.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.0.4 // MAP FIX")}</span>
            <strong>{t("Oil Surface Under Barrels Fixed")}</strong>
            <p>{t("Updated 26 barrel cells across 5 campaign and survival maps so barrels next to oil slicks now sit directly on oil instead of clean ground, and added a map-check script.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.0.3 // BALANCE")}</span>
            <strong>{t("Air Support Credit Costs Rebalanced")}</strong>
            <p>{t("Increased Air Support call costs to $3,000 for Air Strikes and Carpet Air Mines and $2,000 for Air Repair Drone and Supply Air Drop, and updated the Arsenal guide accordingly.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.0.2 // ARCHITECTURE")}</span>
            <strong>{t("Vehicles &amp; Air Ordnance Separation")}</strong>
            <p>{t("Organized all vehicle configs (tanks, aircraft, and repair drone) under public/src/game/vehicles/ and extracted air-dropped bombs, thermobaric missiles, and air mines into public/src/game/components/ordnance.js.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.0.1 // DOCS")}</span>
            <strong>{t("Air Support &amp; Thermobaric Guide Updates")}</strong>
            <p>{t("Updated the How to Play, Arsenal, Destructible Terrain, and Enemies pages (across all 5 locales) with Air Support hotkeys (5–8), call specs, and the reworked 3.5-cell thermobaric ice-melting and swamp effects.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 3.0.0 // AIR SUPPORT")}</span>
            <strong>{t("Tactical Air Support System")}</strong>
            <p>{t("Added a permanent Air Support HUD bar with four credit-purchased combat calls: Air Strike (high-altitude 3-bomb flyby, thermobaric missile, or 15s AC-130 Spooky orbit), Air Repair drone (+20 HP and full module restoration), Carpet Air Mines (3x3 neutral mine drop), and targeted Supply Air Drop, complete with tactical pause map panning.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.10 // CONTRACTS")}</span>
            <strong>{t("Isolated Contracts Session Economy")}</strong>
            <p>{t("Isolated")} <code>{t("Contracts")}</code> {t("credits from the Campaign profile: every contract now deploys with a stock Tier I tank and")} <code>{t("$500")}</code> {t("in session credits (")}<code>{t("CONTRACT_CONFIG.STARTING_CREDITS")}</code>{t("), matching Survival mode.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.9 // BUGFIX")}</span>
            <strong>{t("Forest Canopy Flicker Fix")}</strong>
            <p>{t("Removed unnecessary")} <code>{t("transparent: true")}</code> {t("and")} <code>{t("opacity: 0.9")}</code> {t("from batched")} <code>{t("FOREST")}</code> {t("foliage materials to eliminate instanced depth-sorting flicker across dense forest clusters.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.8 // SEO")}</span>
            <strong>{t("Expanded Multilingual About Page &amp; FAQ Schema")}</strong>
            <p>{t("Expanded the")} <code>{t("/about")}</code> {t("page across all five locales (")}<code>{t("en")}</code>{t(",")} <code>{t("es")}</code>{t(",")} <code>{t("pt-br")}</code>{t(",")} <code>{t("de")}</code>{t(",")} <code>{t("fr")}</code>{t(") with game mode breakdowns, zero-friction browser play copy, a 4-question FAQ section, and")} <code>{t("FAQPage")}</code> {t("JSON-LD.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.7 // BUGFIX")}</span>
            <strong>{t("Flamethrower Pathing &amp; Medal Accuracy Fixes")}</strong>
            <p>{t("Prevented")} <code>{t("FLAMETHROWER")}</code> {t("tanks from stalling on")} <code>{t("breachTarget")}</code> {t("obstacles when the player is beyond flame range, restricted their breaching to")} <code>{t("BOXES")}</code>{t(", passed explosion hit aspect for")} <code>{t("flank_master")}</code> {t("and")} <code>{t("exploit_the_gap")}</code>{t(", fixed")} <code>{t("STEALTH")}</code> {t("stationary detection for")} <code>{t("ghost_hunter")}</code>{t(", and aligned")} <code>{t("hydra_dodger")}</code> {t("and")} <code>{t("titan_breaker")}</code> {t("with")} <code>{t("mammoth_slayer")}</code>{t(".")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.6 // BUGFIX")}</span>
            <strong>{t("Enemy Class Normalization in Medal Tracker")}</strong>
            <p>{t("Fixed an")} <code>{t("enemyClass")}</code> {t("case mismatch in")} <code>{t("createBattleMedalTracker")}</code> {t("where runtime")} <code>{t("EnemyClass")}</code> {t("identifiers (such as")} <code>{t("bossMammoth")}</code>{t(",")} <code>{t("bossHydra")}</code>{t(",")} <code>{t("bossTitan")}</code>{t(", and")} <code>{t("sapper")}</code>{t(") did not match uppercase medal keys, blocking boss and class-specific medals and kill XP.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.5 // BUGFIX")}</span>
            <strong>{t("Mammoth Slayer Medal Fix")}</strong>
            <p>{t("Removed the")} <code>{t("isVictory")}</code> {t("requirement from the")} <code>{t("mammoth_slayer")}</code> {t("medal so defeating")} <code>{t("BOSS_MAMMOTH")}</code> {t("awards the medal regardless of battle outcome, and updated its description across all locales.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.4 // TOOLING")}</span>
            <strong>{t("Migration to pnpm")}</strong>
            <p>{t("Migrated repository package management from npm to pnpm (v12.21.0) with")} <code>{t("pnpm-lock.yaml")}</code>{t(",")} <code>{t("pnpm-workspace.yaml")}</code>{t(", and updated build, deploy, and git hook scripts.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.3 // BALANCE")}</span>
            <strong>{t("Frame-Scaled Repair Kits &amp; Mission 35 Air Drops")}</strong>
            <p>{t("Scaled maximum RM-1 Field Repair Kit and emergency repair kit charges from 1 to 5 based on Frame tier (F1–F5), reduced RM-1 cooldown by ~30% (45s to 32s), and added 5 repair kit charges to Mission 35 air drops.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.2 // BUGFIX")}</span>
            <strong>{t("JAMMER ECM Fix")}</strong>
            <p>{t("Fixed an enemy class case mismatch in")} <code>{t("hasJammerModule")}</code> {t("that prevented")} <code>{t("JAMMER")}</code> {t("tanks from triggering 20-cell radar interference and 5-cell APS / ATGM disruption in live battles, preserved enemy")} <code>{t("loadout")}</code> {t("on spawn, and fixed the same class comparison in battle medal tracking.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.1 // SEO")}</span>
            <strong>{t("Search-Friendly Page Copy")}</strong>
            <p>{t("Reworded the home page and the Battle City comparison page in all five languages to match how players search for free online tank games, added a Chromebook answer to the FAQ and a short tagline under the home page title.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.0 // FRANÇAIS")}</span>
            <strong>{t("French (fr) Localization")}</strong>
            <p>{t("Added full French (fr) support across the battlefield interface (HUD, Garage, medals, settings, banners, and mission briefings) and all 15 localized static pages under")} <code>{t("/fr/")}</code> {t("with")} <code>{t("hreflang")}</code> {t("links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.2.0 // DEUTSCH")}</span>
            <strong>{t("German (de) Localization")}</strong>
            <p>{t("Added full German (de) support across the battlefield interface (HUD, Garage, medals, settings, banners, and mission briefings) and all 15 localized static pages under")} <code>{t("/de/")}</code> {t("with")} <code>{t("hreflang")}</code> {t("links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.1.0 // PORTUGUÊS (BRASIL)")}</span>
            <strong>{t("Brazilian Portuguese (pt-BR) Localization")}</strong>
            <p>{t("Added full Brazilian Portuguese (pt-BR) support across the battlefield interface (HUD, Garage, medals, settings, banners, and mission briefings) and all 15 localized static pages under")} <code>{t("/pt-br/")}</code> {t("with BCP 47")} <code>{t("pt-BR")}</code> {t("hreflang links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.0.0 // ASTRO SITE")}</span>
            <strong>{t("Static Pages Built with Astro")}</strong>
            <p>{t("All guide, mode and info pages, in English and Spanish, are now rendered at build time by Astro from one shared layout, footer and page source per page. URLs, text, meta tags and structured data stay the same, and the game itself still runs as plain ES modules with no bundler.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.31.0 // LANGUAGE MENU")}</span>
            <strong>{t("EN / ES Language Dropdown")}</strong>
            <p>{t("The footer language switcher is now a dropdown menu with English and Spanish options that opens the same page in the chosen language and highlights the current one. The Language setting in Settings is now a select list instead of a cycle button.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
