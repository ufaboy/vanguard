---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("changelog");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Changelog",
        "item": "https://battletank.online/changelog"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="changelog"
  title={"Changelog &amp; Patch Notes — BATTLE TANK"}
  description={"Latest updates, balance patches, new bosses, and engineering improvements for BATTLE TANK 3D browser tank game."}
  ogDescription={"Latest updates, balance patches, and gameplay improvements for BATTLE TANK."}
  twitterDescription={"Release history and gameplay updates for BATTLE TANK 3D."}
  jsonLd={jsonLd}
  bodyPage="changelog"
  script="src/pages/how-to-play.js"
>
        <h1 class="menu-page-title" tabindex="-1">{t("Changelog &amp; Patch Notes")}</h1>
        <p class="menu-lead">
          {t("Release history, balance tuning, and new tactical features for BATTLE TANK.")}
        </p>

        <div class="menu-grid" style="margin-top:24px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.4 // TOOLING")}</span>
            <strong>{t("Migration to pnpm")}</strong>
            <p>{t("Migrated repository package management from npm to pnpm (v11.21.0) with")} <code>{t("pnpm-lock.yaml")}</code>{t(",")} <code>{t("pnpm-workspace.yaml")}</code>{t(", and updated build, deploy, and git hook scripts.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.3 // BALANCE")}</span>
            <strong>{t("Frame-Scaled Repair Kits &amp; Mission 35 Air Drops")}</strong>
            <p>{t("Scaled maximum RM-1 Field Repair Kit and emergency repair kit charges from 1 to 5 based on Frame tier (F1–F5), reduced RM-1 cooldown by ~30% (45s to 32s), and added 5 repair kit charges to Mission 35 air drops.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.2 // BUGFIX")}</span>
            <strong>{t("JAMMER ECM Fix")}</strong>
            <p>{t("Fixed an enemy class case mismatch in")} <code>{t("hasJammerModule")}</code> {t("that prevented")} <code>{t("JAMMER")}</code> {t("tanks from triggering 20-cell radar interference and 5-cell APS / ATGM disruption in live battles, preserved enemy")} <code>{t("loadout")}</code> {t("on spawn, and fixed the same class comparison in battle medal tracking.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.1 // SEO")}</span>
            <strong>{t("Search-Friendly Page Copy")}</strong>
            <p>{t("Reworded the home page and the Battle City comparison page in all five languages to match how players search for free online tank games, added a Chromebook answer to the FAQ and a short tagline under the home page title.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.3.0 // FRANÇAIS")}</span>
            <strong>{t("French (fr) Localization")}</strong>
            <p>{t("Added full French (fr) support across the battlefield interface (HUD, Garage, medals, settings, banners, and mission briefings) and all 15 localized static pages under")} <code>{t("/fr/")}</code> {t("with")} <code>{t("hreflang")}</code> {t("links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.2.0 // DEUTSCH")}</span>
            <strong>{t("German (de) Localization")}</strong>
            <p>{t("Added full German (de) support across the battlefield interface (HUD, Garage, medals, settings, banners, and mission briefings) and all 15 localized static pages under")} <code>{t("/de/")}</code> {t("with")} <code>{t("hreflang")}</code> {t("links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.1.0 // PORTUGUÊS (BRASIL)")}</span>
            <strong>{t("Brazilian Portuguese (pt-BR) Localization")}</strong>
            <p>{t("Added full Brazilian Portuguese (pt-BR) support across the battlefield interface (HUD, Garage, medals, settings, banners, and mission briefings) and all 15 localized static pages under")} <code>{t("/pt-br/")}</code> {t("with BCP 47")} <code>{t("pt-BR")}</code> {t("hreflang links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 2.0.0 // ASTRO SITE")}</span>
            <strong>{t("Static Pages Built with Astro")}</strong>
            <p>{t("All guide, mode and info pages, in English and Spanish, are now rendered at build time by Astro from one shared layout, footer and page source per page. URLs, text, meta tags and structured data stay the same, and the game itself still runs as plain ES modules with no bundler.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.31.0 // LANGUAGE MENU")}</span>
            <strong>{t("EN / ES Language Dropdown")}</strong>
            <p>{t("The footer language switcher is now a dropdown menu with English and Spanish options that opens the same page in the chosen language and highlights the current one. The Language setting in Settings is now a select list instead of a cycle button.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.30.0 // FULL SPANISH SITE")}</span>
            <strong>{t("All Game Modes, Guides &amp; Info Pages in Spanish")}</strong>
            <p>{t("Added Spanish versions under")} <code>{t("/es/")}</code> {t("for 13 more pages:")} <a href={h("./es/campaign")}>{t("Campaign")}</a>, <a href={h("./es/survival")}>{t("Survival")}</a>, <a href={h("./es/contracts")}>{t("Contracts")}</a>, <a href={h("./es/how-to-play")}>{t("How to Play")}</a>, <a href={h("./es/walkthrough")}>{t("Walkthrough")}</a>, <a href={h("./es/arsenal")}>{t("Arsenal")}</a>, <a href={h("./es/destructible-terrain")}>{t("Destructible Terrain")}</a>, <a href={h("./es/games-like-battle-city")}>{t("Games Like Battle City")}</a>, <a href={h("./es/webgl-tank-game")}>{t("Under the Hood")}</a>, <a href={h("./es/about")}>{t("About")}</a>, <a href={h("./es/privacy-policy")}>{t("Privacy Policy")}</a>, <a href={h("./es/terms")}>{t("Terms")}</a> {t("and")} <a href={h("./es/contact")}>{t("Contact")}</a>{t(", complete with")} <code>{t("hreflang")}</code> {t("links and sitemap entries.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.29.2 // LANGUAGE SWITCHER &amp; SITEMAP")}</span>
            <strong>{t("Highlighted Footer Language Toggle &amp; Sitemap Hreflang Links")}</strong>
            <p>{t("Styled the footer language switcher with an amber tactical badge and globe icon so it stands out from regular links, and added")} <code>{t("xhtml:link")}</code> <code>{t("hreflang")}</code> {t("alternates for the English and Spanish page pairs in")} <code>{t("sitemap.xml")}</code>.</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.29.1 // FOOTER CLEANUP")}</span>
            <strong>{t("Removed Armored Footer Bracket Decoration")}</strong>
            <p>{t("Removed the decorative")} <code>{t(".armored-footer-bracket")}</code> {t("element and its CSS rules across all public pages for a cleaner footer bar.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.29.0 // SPANISH LANGUAGE")}</span>
            <strong>{t("Play BATTLE TANK in Spanish")}</strong>
            <p>{t("The whole battlefield interface is now available in Spanish: HUD, Garage, pause and result screens, medals, status banners, tank and component names, and mission briefings shown in battle. Choose the language in Settings, or open the new Spanish")} <a href={h("./es/")}>{t("home page")}</a> {t("and")} <a href={h("./es/enemies")}>{t("enemy guide")}</a>{t(". The game remembers your choice, and every other page stays in English.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.28.0 // MARKDOWN FOR AI AGENTS")}</span>
            <strong>{t("Markdown Copies of Every Page &amp; Full-Site llms-full.txt")}</strong>
            <p>{t("Every public page now has a clean Markdown copy for AI assistants and agents: add")} <code>{t(".md")}</code> {t("to its address (the home page is")} <code>{t("/index.md")}</code>{t("). Each page links its copy,")} <code>{t("llms.txt")}</code> {t("now points to the Markdown versions, and the new")} <code>{t("llms-full.txt")}</code> {t("holds the whole site in one file. The copies are generated from the pages on every release, so they always match the site.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.27.0 // NEW GUIDES &amp; TERMS OF SERVICE")}</span>
            <strong>{t("Destructible Terrain Guide, Battle City Comparison, Tech Page &amp; Terms")}</strong>
            <p>{t("Added four new pages: a")} <a href={h("./destructible-terrain")}>{t("Destructible Terrain guide")}</a> {t("covering every wall, surface and explosive object;")} <a href={h("./games-like-battle-city")}>{t("Games Like Battle City")}</a>{t(", comparing BATTLE TANK with the 1985 arcade classic;")} <a href={h("./webgl-tank-game")}>{t("Under the Hood")}</a>{t(", explaining the Three.js and WebGL engine; and")} <a href={h("./terms")}>{t("Terms of Service")}</a>{t(". Every page footer now links to all guides. The game is now described as \"inspired by Battle City\" instead of a remake, and between-mission ad breaks are limited to one every 120 seconds.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.26.2 // SEO PAGE METADATA &amp; HOME FAQ")}</span>
            <strong>{t("Search-Friendly Page Titles, Home Page FAQ &amp; Richer Structured Data")}</strong>
            <p>{t("Rewrote the home page title, description and social cards around 3D isometric Battle City-style tank combat, co-typed its JSON-LD as")} <code>{t("VideoGame")}</code> + <code>{t("WebApplication")}</code>{t(", and added an 8-question FAQ with matching")} <code>{t("FAQPage")}</code> {t("markup. Campaign, Survival, Contracts, Arsenal, Enemies and How to Play now each have their own focused title, description, heading, intro line and image descriptions.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.26.0 // PASSIVE JAMMER ECM REWORK")}</span>
            <strong>{t("Continuous 20-Cell Radar Interference &amp; 5-Cell APS / ATGM Disruption")}</strong>
            <p>{t("Reworked the")} <code>{t("JAMMER")}</code> {t("module into a continuously active passive ECM system: within 20 cells it scrambles the player's radar (hiding 50% of real contacts and injecting 50% false blips), and within 5 cells it disables player APS interception, blocks ATGM launch, and makes in-flight player ATGMs lose lock and fly straight to a random impact point up to 3 cells ahead. The Jammer now screens allies from 3-5 cells in timed runs and withdraws out of sight between them. Removed the legacy periodic jammer pulse ability.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.25.2 // AIRDROP LANDING VALIDATION &amp; MID-FLIGHT DRIFT")}</span>
            <strong>{t("Prevent AirDrop Crates from Landing on Occupied Cells &amp; Shift Target Mid-Flight")}</strong>
            <p>{t("Updated")} <code>{t("PowerupsController")}</code> {t("and")} <code>{t("engineerSupport")}</code> {t("so parachute AirDrops avoid live turrets, burning tiles, mines, pickups, tanks, and newly built")} <code>{t("BRICK")}</code> {t("walls, allow landing on")} <code>{t("GRASS")}</code> {t("and")} <code>{t("STONE")}</code>{t(", and smoothly drift to the nearest clear cell if their target becomes occupied during descent.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.25.1 // FOREST GROUND ZONE DECORATION FIX")}</span>
            <strong>{t("Paint Zone Surfaces Under FOREST &amp; Decoration Tiles on GROUND")}</strong>
            <p>{t("Fixed")} <code>{t("decorationCellAllowed")}</code> {t("and")} <code>{t("paintDecoration")}</code> {t("in")} <code>{t("decoration.js")}</code> {t("and")} <code>{t("urban-ground.js")}</code> {t("to check")} <code>{t("surfaceGrid")}</code> {t("instead of the top-layer")} <code>{t("grid")}</code>{t(", preventing light-gray unmasked squares from appearing beneath")} <code>{t("FOREST")}</code> {t("clusters inside asphalt, concrete, and gravel decoration zones.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.25.0 // LAYERED TERRAIN, SURFACE &amp; OBJECT ARCHITECTURE")}</span>
            <strong>{t("Separated Surface, Decoration, Facility &amp; Wall Layers, Removed SPAWNER &amp; Migrated All Maps")}</strong>
            <p>{t("Reworked arena cells into explicit")} <code>{t("surface")}</code> (<code>{t("GROUND")}</code>, <code>{t("ROAD")}</code>, <code>{t("GRASS")}</code>, <code>{t("STONE")}</code>, <code>{t("SAND")}</code>, <code>{t("WATER")}</code>, <code>{t("ICE")}</code>, <code>{t("SWAMP")}</code>, <code>{t("OIL_SLICK")}</code>{t(") and primary object (")}<code>{t("decoration")}</code>, <code>{t("facility")}</code>, <code>{t("wall")}</code>{t(") layers with placement compatibility checks (")}<code>{t("layers.js")}</code>, <code>{t("surfaces.js")}</code>{t("). New")} <code>{t("STONE")}</code> {t("rocky ground caps tracked hulls at 1.5 cells/s (CH4 / CH5 / hover immune). Removed hardcoded soil decals under")} <code>{t("FOREST")}</code> {t("trees (grass and stone patches are instanced), completely removed legacy")} <code>{t("SPAWNER")}</code> {t("pads (enemies enter through each map's")} <code>{t("enemies.entrances")}</code>{t("), enabled wave-like forest fire spread, and migrated all 39 maps to dual")} <code>{t("surfaceLayout")}</code> + <code>{t("objectLayout")}</code> {t("grids. Tank traction now combines both layers from the surface catalog for the player and enemies (a crater on a road keeps part of the road bonus); craters keep the road or grass beneath them, and exploded barrels no longer leave invisible obstacles.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.24.1 // BURNING OIL SPREAD TO FOREST &amp; BUILDING DAMAGE")}</span>
            <strong>{t("Burning Oil Slicks Ignite Adjacent Forests &amp; Damage Neighboring Buildings")}</strong>
            <p>{t("Updated")} <code>{t("TerrainDestructionController.updateBurningOil")}</code> {t("so burning")} <code>{t("OIL_SLICK")}</code> {t("tiles ignite orthogonally adjacent")} <code>{t("FOREST")}</code> {t("cells after flashover and deal periodic fire damage (4 HP/s) to neighboring")} <code>{t("HOUSE_1")}</code> {t("and")} <code>{t("HOUSE_2")}</code> {t("buildings.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.24.0 // VOLATILE OIL SLICK INFERNO, IGNITION &amp; MAP DISTRIBUTION")}</span>
            <strong>{t("3D Burning Oil Slick Inferno, Full Ignition Triggers &amp; Map-Wide Oil Placement")}</strong>
            <p>{t("Overhauled burning")} <code>{t("OIL_SLICK")}</code> {t("visuals with a 3D animated fire-bed, 6 flickering flame tongues, boiling oil rings, and multi-layered fire, spark, and black smoke particles (")}<code>{t("models.js")}</code>, <code>{t("fx-system.js")}</code>{t(", and 3D Codex). Added chain ignition across adjacent oil tiles, ignition from destroyed tanks, thermobaric blasts, burning forests, and tank-hitting shells, fixed per-frame fire DoT screen-shake/audio spam, and placed 290 new")} <code>{t("OIL_SLICK")}</code> {t("tiles across all 39 campaign, contract, and survival maps.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.8 // TABLET TOUCH CONTROLS AUTO-DETECTION REFINEMENT")}</span>
            <strong>{t("Prevent Tablet Touch Controls from Auto-Activating on Desktop Resolutions &amp; Mouse Input")}</strong>
            <p>{t("Refined")} <code>{t("isTouchCapable()")}</code> {t("and")} <code>{t("isMobileOrTabletDevice()")}</code> {t("to exclude desktop viewports wider than 1366px and desktop touch/stylus laptops with a fine primary pointer, and updated")} <code>{t("main.js")}</code> {t("to sync touch controls on viewport resize and hide them on mouse interaction in")} <code>{t("auto")}</code> {t("mode.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.7 // PRODUCTION HOSTNAME GATE FOR GTM &amp; ADSENSE")}</span>
            <strong>{t("Gate Google Tag Manager &amp; AdSense Script Loading to Production Domain Only")}</strong>
            <p>{t("Restricted Google Tag Manager (")}<code>{t("gtm.js")}</code>{t(") and Google AdSense (")}<code>{t("adsbygoogle.js")}</code>{t(") script loading across all HTML pages strictly to the production hostname (")}<code>{t("battletank.online")}</code>{t("), preventing analytics and ad requests on preview deployments and localhost, and simplified the Itch.io build script in")} <code>{t("scripts/build-itch.mjs")}</code>.</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.6 // ANALYTICS TELEMETRY, INTERNAL TRAFFIC FLAG &amp; FPS SAMPLING")}</span>
            <strong>{t("Refined GA4 Telemetry, Internal Traffic Filter, Average FPS Sampling &amp; Campaign Progress Property")}</strong>
            <p>{t("Added")} <code>{t("?internal=1")}</code> {t("developer traffic tagging across all HTML pages, removed duplicate manual")} <code>{t("page_view")}</code> {t("dispatches in favor of native Google Tag tracking, and added")} <code>{t("game_ready")}</code> {t("load timing, combat")} <code>{t("fps_avg")}</code> {t("sampling,")} <code>{t("max_mission")}</code> {t("user properties, and pre-navigation")} <code>{t("mission_abort")}</code> {t("settlement.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.5 // SEO METADATA &amp; DEPLOY SITEMAP REFRESH")}</span>
            <strong>{t("Updated Home Page SEO Metadata &amp; Automated Sitemap / JSON-LD Version Sync on Deploy")}</strong>
            <p>{t("Refined the home page title, meta description, Open Graph, Twitter Card, and JSON-LD metadata in")} <code>{t("index.html")}</code>{t(", and updated")} <code>{t("scripts/deploy.mjs")}</code> {t("to automatically sync each sitemap URL's")} <code>{t("&lt;lastmod&gt;")}</code> {t("date from Git history and the home page JSON-LD")} <code>{t("softwareVersion")}</code> {t("from")} <code>{t("package.json")}</code> {t("during deployment.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.4 // HOME, CAMPAIGN, CONTRACTS &amp; SURVIVAL BRIEFING SECTIONS")}</span>
            <strong>{t("Scrollable Mode Briefings &amp; Overview Sections on Home, Campaign, Contracts &amp; Survival Pages")}</strong>
            <p>{t("Added scrollable mode overview and rules briefings to")} <code>{t("index.html")}</code>, <code>{t("campaign.html")}</code>, <code>{t("contracts.html")}</code>{t(", and")} <code>{t("survival.html")}</code> {t("along with responsive")} <code>{t(".page-briefing")}</code> {t("layout rules in")} <code>{t("src/index.css")}</code>.</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.3 // BURNING FOREST ENEMY KILL FIX")}</span>
            <strong>{t("Fix Enemy Tank Freezing &amp; Becoming Invulnerable When Killed by Burning Forest")}</strong>
            <p>{t("Fixed a bug in")} <code>{t("ForestFireController.update")}</code> {t("where direct subtraction from")} <code>{t("enemy.hp")}</code> {t("before calling")} <code>{t("damageEnemy")}</code> {t("caused enemies killed by burning forest to hit the")} <code>{t("enemy.hp &lt;= DURABILITY.ZERO_HP")}</code> {t("early return in")} <code>{t("damageEnemy")}</code>{t(", leaving an immobile, invulnerable wreck on the burned-out")} <code>{t("SAND")}</code> {t("tile.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.2 // ENEMY HQ SIEGE RESUPPLY AIR DROP")}</span>
            <strong>{t("Automatic Air Drop Near Enemy HQ After All Enemy Tanks Are Cleared")}</strong>
            <p>{t("On maps with a fortified Enemy Base (")}<code>{t("ENEMY_BASE")}</code>{t("), eliminating all enemy tanks while the Enemy HQ is still standing now automatically dispatches a parachute resupply Air Drop onto a passable cell 2–6 tiles from the Enemy HQ so the player can finish demolishing the stronghold without driving back to the Allied Base.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.1 // 3D CODEX BUILDING &amp; RUBBLE INSPECTOR")}</span>
            <strong>{t("1-Story &amp; 2-Story Modular Buildings &amp; Rubble Added to 3D Codex")}</strong>
            <p>{t("Added")} <code>{t("HOUSE_1")}</code> {t("(1-Story Modular Building),")} <code>{t("HOUSE_2")}</code> {t("(2-Story Modular Building), and")} <code>{t("RUBBLE")}</code> {t("(Concrete Building Rubble) to")} <code>{t("SURFACE_CATALOG")}</code> {t("and the 3D Codex studio. Includes an interactive Building Configurator to inspect all 8 residential styles (Iteration 1), all 4 industrial/warehouse/office styles (Iteration 2), and every progressive destruction stage down to collapsed rubble, plus live")} <code>{t("SPACE")}</code> {t("/ Test Fire demolition effects.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.23.0 // INDUSTRIAL, WAREHOUSE &amp; OFFICE BUILDINGS ACROSS ALL THEMES")}</span>
            <strong>{t("New 1–2 Story Industrial, Warehouse &amp; Office Buildings &amp; Theme-Based Map Distribution")}</strong>
            <p>{t("Expanded the modular building system (")}<code>{t("public/models/terrain/buildings.glb")}</code>{t(") with 4 new 1-story and 4 new 2-story industrial, warehouse, and office building styles (windowless corrugated steel warehouses, sawtooth brick factories, barrel-arch supply depots, heavy industrial plants, and high-bay logistics hubs alongside windowed site, curtain-wall, and administrative offices). Added buildings across all sector themes with theme-specific residential vs. industrial/office proportions:")} <code>{t("forest")}</code> (50%/50%), <code>{t("desert")}</code> (25%/75%), <code>{t("coast")}</code> (75%/25%), <code>{t("alpine")}</code> (50%/50%), <code>{t("industrial")}</code> {t("(25%/75%), and")} <code>{t("capital")}</code> (75%/25%).</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.22.5 // CONCRETE DAMAGE TINT FIX")}</span>
            <strong>{t("Darkened Concrete Damage Ramp Matching Intact Concrete Tint")}</strong>
            <p>{t("Aligned the per-hit damage darkening ramp in")} <code>{t("updateConcreteBlockDamage")}</code> {t("and procedural concrete materials with the intact")} <code>{t("CONCRETE")}</code> {t("base color (")}<code>0x8c96a3</code>{t(") so damaged concrete blocks progressively darken on hit instead of jumping to a legacy lighter shade.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("VERSION 1.22.4 // ENEMY UPDATE LOOP CRASH FIX &amp; AUDIO AUTOPLAY GUARD")}</span>
            <strong>{t("Multi-Kill Enemy Iteration Fix &amp; User-Gesture AudioContext Unlock")}</strong>
