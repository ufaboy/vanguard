---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("destructible-terrain");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Destructible Terrain",
        "item": "https://battletank.online/destructible-terrain"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="destructible-terrain"
  title={"Destructible Terrain Tank Game: Arenas &amp; Walls — BATTLE TANK"}
  description={"How destructible terrain works in BATTLE TANK, a free 3D tank game in your browser: brick and concrete walls, forest cover, water, ice, mud, oil fires and craters."}
  ogType="article"
  jsonLd={jsonLd}
  bodyPage="destructible-terrain"
  script="src/pages/static-page.js"
>
        <h1 class="menu-page-title" tabindex="-1">{t("Destructible Terrain &amp; 40×40 Tactical Arenas")}</h1>
        <p class="menu-lead">{t("BATTLE TANK is a")} <a href={h("./")}>{t("free 3D isometric tank game")}</a> {t("where the map is part of the fight. Every battle takes place on a 40×40 grid of 1,600 cells, and almost every wall, crate and building can be shot apart. This guide covers each terrain type, how much punishment it takes, and how to use it for cover, ambushes and shortcuts.")}</p>
        
        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Destructible Walls: Brick, Concrete and Buildings")}</h2>
        <p style="margin-top:12px;">{t("Walls are the core of every arena. You can hide behind them, shoot through them to open a new lane, or leave them standing to protect your Command Base HQ. How quickly a wall falls depends on your cannon: Mk1–Mk3 shells chip walls slowly, while the heavy Mk4 and Mk5 guns tear them down several times faster.")}</p>
        <figure class="menu-card" style="cursor:default;padding:14px;margin-top:16px;">
          <img src={h("./images/home-battle.webp")} alt={t("VANGUARD tank firing through destructible brick walls in a 3D isometric urban arena")} loading="lazy" width="1280" height="720" style="width:100%;height:auto;border-radius:4px;display:block;">
          <figcaption style="margin-top:10px;color:#acbcbd;font-size:13px;">{t("Brick walls break into sub-blocks hit by hit; concrete cracks and exposes its steel rebar before it collapses.")}</figcaption>
        </figure>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("BRICK // 4 HP")}</span>
            <strong>{t("Destructible Brick Wall")}</strong>
            <p>{t("Each cell is built from 4 sub-blocks. Mk1–Mk3 shells remove one layer per hit; Mk4/Mk5 heavy shells remove two. Enemy Engineer tanks can rebuild brick walls during the fight.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("CONCRETE // 16 HP")}</span>
            <strong>{t("Reinforced Concrete")}</strong>
            <p>{t("A hard wall with a steel rebar cage. Standard shells deal 1 HP per hit (16 hits), Mk4/Mk5 shells deal 4 HP and artillery blasts 6 HP. Craters open on the faces that were hit and expose the rebar.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("BUILDINGS // 25–70 HP")}</span>
            <strong>{t("Houses, Factories &amp; Offices")}</strong>
            <p>{t("One- and two-story buildings with 5 to 7 visible damage stages. Shells strip the facade and roof down to the frame, then the building collapses into rubble that slows every tank.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("FORTRESS // 48–100 HP")}</span>
            <strong>{t("Enemy Strongholds &amp; Turrets")}</strong>
            <p>{t("In stronghold assault missions the enemy citadel (48 HP) is ringed by concrete and guarded by cannon, howitzer and rocket turrets (100 HP each). Destroying the citadel wins the mission.")}</p>
          </article>
        </div>
        
        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Cover, Concealment and Line of Sight")}</h2>
        <p style="margin-top:12px;">{t("Directional armor makes positioning decisive: tanks are strongest from the front and weakest from the rear, so terrain that hides your flank is worth as much as a cannon upgrade. Enemies use the same rules, and their AI actively looks for forest, chokepoints and cells hidden from you.")}</p>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("FOREST")}</span>
            <strong>{t("Camouflage Canopy")}</strong>
            <p>{t("Tanks inside forest cells are hidden from view and break the lock of enemy guided missiles. Flamethrowers, air-dropped bombs, and thermobaric blasts ignite forests, burning them down over time.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("HEDGEHOGS")}</span>
            <strong>{t("Anti-Tank Obstacles")}</strong>
            <p>{t("Steel hedgehogs block every chassis but sit low enough for shells and missiles to fly over them, which makes them ideal firing positions at chokepoints.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("CRATERS")}</span>
            <strong>{t("Blast Craters")}</strong>
            <p>{t("Heavy explosions gouge craters into the ground. A tank sitting in a crater takes 30% less splash and artillery damage, at the cost of a 15% speed penalty.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("LANDMARKS")}</span>
            <strong>{t("Monuments")}</strong>
            <p>{t("Indestructible landmarks block movement, shells, missiles and line of sight completely. They are permanent cover that no weapon can remove.")}</p>
          </article>
        </div>
        
        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Water, Ice, Mud and Other Surfaces")}</h2>
        <p style="margin-top:12px;">{t("Every cell has a ground surface that changes how tanks drive. Speed, acceleration and turning are combined from the surface and anything standing on it, so a crater on a road keeps part of the road bonus. The")} <a href={h("./arsenal")}>{t("CH4 All-Terrain and CH5 Grav-Hover chassis")}</a> {t("ignore almost all of these penalties.")}</p>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("WATER")}</span>
            <strong>{t("Deep Water Channels")}</strong>
            <p>{t("Standard tracks (CH1–CH3) cannot enter deep water, but shells and missiles fly across it freely. The CH4 All-Terrain chassis wades across and the CH5 Grav-Hover glides over it, opening routes enemies do not expect.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("ICE")}</span>
            <strong>{t("Low-Traction Ice")}</strong>
            <p>{t("Acceleration drops from 22 to 4.5 and braking from 14 to 1.8, so heavy tanks slide through turns. Thermobaric blasts melt ice into deep water—plan your stops early or fit an all-terrain chassis.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("SWAMP &amp; SAND")}</span>
            <strong>{t("Mud and Scorched Sand")}</strong>
            <p>{t("Swamp slows tracked tanks to 58% speed and 65% turn rate (thermobaric blasts also boil water into swamp). Sand costs 22% speed and offers no concealment.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("ROADS &amp; STONE")}</span>
            <strong>{t("Highways, Bridges and Rock Fields")}</strong>
            <p>{t("Roads and bridges give +20% top speed and +25% acceleration but no cover. Rock fields cap tracked tanks at 1.5 cells per second, whatever the engine.")}</p>
          </article>
        </div>
        
        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Explosive and Interactive Objects")}</h2>
        <p style="margin-top:12px;">{t("Some objects react to fire and can change a whole section of the map in a second. Learning them turns the arena into a weapon.")}</p>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("FUEL DRUMS")}</span>
            <strong>{t("Explosive Barrels")}</strong>
            <p>{t("Any hit detonates a drum for 35 damage in a 2.8-cell radius. The blast knocks down nearby brick, damages concrete and sets off neighbouring drums in a chain reaction.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("OIL SLICKS")}</span>
            <strong>{t("Volatile Oil")}</strong>
            <p>{t("Oil makes tracks drift like ice. A shell, flame or nearby explosion ignites it for 7 seconds of fire damage and thick smoke that hides tanks.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("WATER TOWERS")}</span>
            <strong>{t("Pressurized Water Towers")}</strong>
            <p>{t("Shooting a tower (2 HP) floods the ground around it into swamp and puts out every forest and oil fire within 2.5 cells.")}</p>
          </article>
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("SUPPLY BOXES")}</span>
            <strong>{t("Wooden Supply Caches")}</strong>
            <p>{t("Two hits open a cache and drop a field power-up (repair, EMP, APS charge, missile, cannon shells or HQ restore) that waits until you drive over it.")}</p>
          </article>
        </div>
        
        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Defending the Command Base HQ")}</h2>
        <p style="margin-top:12px;">{t("Your Command Base is a two-bay workshop on the edge of the map. A 4-cell line of reinforced concrete stands two rows in front of it, with an open lane so you can drive up for repairs (+3 HP per second within 2.5 cells). Every enemy that breaks through that line threatens the HQ, so many players keep the concrete intact and fight in front of it rather than behind it.")}</p>
        <p style="margin-top:12px;">{t("Ready to put this into practice? The")} <a href={h("./how-to-play")}>{t("How to Play guide")}</a> {t("covers controls and tactics, and the")} <a href={h("./walkthrough")}>{t("Campaign Walkthrough")}</a> {t("shows how each region's terrain shapes its missions.")}</p>
        
        <div class="menu-actions" style="margin-top:28px;">
          <a class="menu-primary" href={h("./campaign")}>{t("Launch Campaign →")}</a>
          <a class="menu-secondary" href={h("./how-to-play")}>{t("How to Play")}</a>
          <a class="menu-secondary" href={h("./arsenal")}>{t("Tank Upgrades")}</a>
          <a class="menu-secondary" href={h("./enemies")}>{t("Enemy Tanks")}</a>
        </div>

  <Fragment slot="noscript">
      <main style="max-width:720px;margin:48px auto;padding:24px;font-family:system-ui,sans-serif;color:#f8fafc;">
        <h1>{t("Destructible Terrain Tank Game: Arenas &amp; Walls — BATTLE TANK")}</h1>
        <p>{t("BATTLE TANK is a free browser tank game with destructible terrain: brick and concrete walls, forest cover, water, ice, mud, burning oil and blast craters on 40x40 arenas.")}</p>
      </main>
  </Fragment>
</PageLayout>
