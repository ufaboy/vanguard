---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import CampaignRegionMaps from '../../components/CampaignRegionMaps.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("campaign");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Campaign",
        "item": "https://battletank.online/campaign"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="campaign"
  title={"Tank Campaign: Road to the Capital — BATTLE TANK"}
  description={"Play a 38-mission 3D tank campaign in your browser, no download. Advance sector by sector through seven regions, inspect recon maps, and defeat four Sector Bosses."}
  ogDescription={"38 tactical 3D tank missions across seven regions on the Road to the Capital. Free in your browser."}
  twitterDescription={"38 tactical 3D tank missions across seven regions in a free Battle City-style browser game."}
  image={"https://battletank.online/images/campaign/mission-01.webp"}
  jsonLd={jsonLd}
  bodyPage="campaign"
  contentClass="menu-content campaign-content"
  script="src/pages/campaign.js"
>
  <script is:inline>
    (function () {
      try {
        var qs = new URLSearchParams(location.search).get('mission');
        if (qs && qs !== 'campaign-01') {
          document.documentElement.classList.add('campaign-hydrating');
          setTimeout(function () { document.documentElement.classList.remove('campaign-hydrating'); }, 2000);
          return;
        }
        var raw = localStorage.getItem('battle_tank_player_save_v1');
        if (!raw) return;
        var save = JSON.parse(raw);
        var done = save && save.completedMissions;
        if (done && typeof done === 'object' && Object.keys(done).length > 0 && !qs) {
          document.documentElement.classList.add('campaign-hydrating');
          setTimeout(function () { document.documentElement.classList.remove('campaign-hydrating'); }, 2000);
        }
      } catch {}
    })();
  </script>
  <h1 class="campaign-page-title" tabindex="-1">{t("Campaign: Road to the Capital")}</h1>

  <div class="campaign-goal-banner" role="region" aria-label={t("OPERATION GOAL")}>
    <div class="campaign-goal-main">
      <span class="campaign-goal-badge">{t("OPERATION GOAL")}</span>
      <p class="campaign-goal-text">{t("Director Viktor Kranz and the Iron Consortium have seized four Project Prometheus prototypes in Rome, turning Europe into a mobile assembly line for Sector Bosses along the Iron Road. Pursue the convoy from the Colosseum to Barcelona, break every stronghold, and stop the freighter before Titan sails.")}</p>
    </div>
  </div>

  <nav class="campaign-nav" aria-label={t("Mission navigation")}>
    <button
      type="button"
      class="campaign-nav-arrow"
      data-action="prev-campaign-mission"
      aria-label={t("Previous mission")}
      disabled
    >‹</button>

    <div class="campaign-nav-track">
      <div class="campaign-region-group" style="--region-accent:#d6e7a0;">
        <span class="campaign-region-label" style="--region-accent:#d6e7a0;">{t("Italy")}</span>
        <div class="campaign-region-missions">
          <button
            type="button"
            class="campaign-mission-btn is-available is-selected"
            style="--region-accent:#d6e7a0;"
            data-action="select-campaign-mission"
            data-mission="campaign-01"
            aria-pressed="true"
            aria-label={t("Mission 1: Rome: Forum & Colosseum. available.")}
            title={t("01. Rome: Forum & Colosseum")}
          ><span class="nav-pulse" aria-hidden="true"></span><svg class="nav-status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 17.5L3 6V3h3l11.5 11.5"/><path d="M13 19l6-6"/><path d="M16 16l4 4"/><path d="M19 21l2-2"/><path d="M9.5 17.5L21 6V3h-3L6.5 14.5"/><path d="M11 19l-6-6"/><path d="M8 16l-4 4"/><path d="M5 21l-2-2"/></svg><span class="nav-num">01</span></button>
          <button
            type="button"
            class="campaign-mission-btn is-locked"
            style="--region-accent:#d6e7a0;"
            data-action="select-campaign-mission"
            data-mission="campaign-02"
            aria-pressed="false"
            aria-label={t("Mission 2: Placeholder Mission. locked.")}
            title={t("02. Placeholder Mission")}
          ><svg class="nav-status-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10h-1V7a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-3a2 2 0 1 1 4 0v3h-4V7zm3 8.73V17a1 1 0 1 1-2 0v-1.27a1.5 1.5 0 1 1 2 0z"/></svg><span class="nav-num">02</span></button>
          <button
            type="button"
            class="campaign-mission-btn is-locked"
            style="--region-accent:#d6e7a0;"
            data-action="select-campaign-mission"
            data-mission="campaign-03"
            aria-pressed="false"
            aria-label={t("Mission 3: Placeholder Mission. locked.")}
            title={t("03. Placeholder Mission")}
          ><svg class="nav-status-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10h-1V7a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-3a2 2 0 1 1 4 0v3h-4V7zm3 8.73V17a1 1 0 1 1-2 0v-1.27a1.5 1.5 0 1 1 2 0z"/></svg><span class="nav-num">03</span></button>
          <button
            type="button"
            class="campaign-mission-btn is-locked"
            style="--region-accent:#d6e7a0;"
            data-action="select-campaign-mission"
            data-mission="campaign-04"
            aria-pressed="false"
            aria-label={t("Mission 4: Placeholder Mission. locked.")}
            title={t("04. Placeholder Mission")}
          ><svg class="nav-status-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10h-1V7a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-3a2 2 0 1 1 4 0v3h-4V7zm3 8.73V17a1 1 0 1 1-2 0v-1.27a1.5 1.5 0 1 1 2 0z"/></svg><span class="nav-num">04</span></button>
          <button
            type="button"
            class="campaign-mission-btn is-locked"
            style="--region-accent:#d6e7a0;"
            data-action="select-campaign-mission"
            data-mission="campaign-05"
            aria-pressed="false"
            aria-label={t("Mission 5: Placeholder Mission. locked.")}
            title={t("05. Placeholder Mission")}
          ><svg class="nav-status-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10h-1V7a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-3a2 2 0 1 1 4 0v3h-4V7zm3 8.73V17a1 1 0 1 1-2 0v-1.27a1.5 1.5 0 1 1 2 0z"/></svg><span class="nav-num">05</span></button>
        </div>
      </div>

      <span class="campaign-next-region" aria-disabled="true">
        <svg class="nav-status-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10h-1V7a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-3a2 2 0 1 1 4 0v3h-4V7zm3 8.73V17a1 1 0 1 1-2 0v-1.27a1.5 1.5 0 1 1 2 0z"/></svg>
        <span>{t("Next: Alps · 2/7")}</span>
      </span>
    </div>

    <button
      type="button"
      class="campaign-nav-arrow"
      data-action="next-campaign-mission"
      aria-label={t("Next mission")}
    >›</button>
  </nav>

  <section class="campaign-workspace" style="--region-accent:#d6e7a0;" aria-label={t("Mission briefing")}>
    <div class="campaign-region-map-panel" aria-label={t("Campaign regions")}>
      <CampaignRegionMaps />
      <div class="campaign-brief-actions">
        <button
          type="button"
          class="brief-start-btn"
          data-action="start-campaign-mission"
          data-mission="campaign-01"
        >
          <span class="start-content">
            <svg class="start-tank-icon" viewBox="0 0 48 22" fill="currentColor" aria-hidden="true">
              <path d="M18 4h11l2 4h14v2.5H31l1.5 3.5H13l3-6h2V4zm-8 10h28l4 4H6l4-4zm2 4.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
            </svg>
            <span class="start-text">{t("START MISSION »")}</span>
          </span>
          <span class="start-glow" aria-hidden="true"></span>
        </button>
      </div>
    </div>

    <div class="campaign-briefing-panel">
      <h2 class="campaign-brief-title">{t("Rome: Forum & Colosseum")}</h2>
      <div class="campaign-brief-block">
        <p class="campaign-brief-objective">{t("Clear the Consortium strike teams before they regroup")}</p>
      </div>

      <div class="campaign-brief-block" data-mission-situation>
        <p class="campaign-brief-text">{t("Two thousand years ago empires were decided here; today Kranz's strike teams have seized four Prometheus prototypes on Via dei Fori Imperiali and are covering the convoy's escape north. Vanguard-1, break their perimeter around the Forum and Colosseum before the dust settles—clearing Rome restores satellite tracking and opens the pursuit into the Apennines.")}</p>
      </div>

      <p class="campaign-brief-classified" hidden></p>
    </div>

    <div class="campaign-recon-panel">
      <div class="campaign-recon-square is-missing-img">
        <img class="campaign-recon-img" width="600" height="600" src={h("./images/campaign/mission-01.webp")} alt={t("Rome: Forum & Colosseum — Reconnaissance map")} />
        <div class="campaign-recon-hud" aria-hidden="true">
          <span class="recon-hud-corner is-tl"></span>
          <span class="recon-hud-corner is-tr"></span>
          <span class="recon-hud-corner is-bl"></span>
          <span class="recon-hud-corner is-br"></span>
          <svg class="recon-hud-reticle" viewBox="0 0 120 120" fill="none" aria-hidden="true">
            <path d="M20 38V20H38M82 20H100V38M100 82V100H82M38 100H20V82" stroke="currentColor" stroke-width="2.2"/>
            <path d="M60 10V28M60 92V110M10 60H28M92 60H110" stroke="currentColor" stroke-width="1.6"/>
            <path d="M44 60H53M67 60H76M60 44V53M60 67V76" stroke="currentColor" stroke-width="1.6"/>
            <circle cx="60" cy="60" r="2" fill="currentColor"/>
          </svg>
          <div class="recon-hud-top">
            <span class="recon-hud-pill" data-recon-sector>SEC-01</span>
            <span class="recon-hud-pill"><span class="recon-live-dot"></span>RECON</span>
          </div>
        </div>
        <div class="campaign-recon-fallback" aria-hidden="true">
          <div class="recon-radar-rings"></div>
          <span class="recon-pending-label">{t("Recon imagery pending")}</span>
        </div>
        <div class="campaign-recon-classified">
          <span class="classified-stamp">{t("CLASSIFIED")}</span>
          <span class="campaign-classified-sub">{t("Pass Sector {n} to unlock recon imagery", { n: 0 })}</span>
        </div>
      </div>

      <div class="campaign-brief-details">
        <div class="campaign-brief-block">
          <p class="campaign-brief-layout">{t("Interlocking urban loops through the Roman Forum, the Arch of Constantine, a bent imperial avenue lined with umbrella pines, and the Colosseum square. Tight stone ruins create crossfire lanes with three destructible breaches and a howitzer covering the central approach.")}</p>
        </div>
        <div class="campaign-brief-block">
          <div class="campaign-roster-chips">
            <a class="campaign-roster-chip" href={`${h("./enemies")}#scout`}><span class="campaign-roster-name">{t('Recon Light Tank "Viper"')}</span><span class="campaign-roster-count">×5</span></a>
            <a class="campaign-roster-chip" href={`${h("./enemies")}#standard`}><span class="campaign-roster-name">{t('Standard Battle Tank "Lancet"')}</span><span class="campaign-roster-count">×14</span></a>
            <a class="campaign-roster-chip" href={`${h("./enemies")}#howitzer`}><span class="campaign-roster-name">{t('Howitzer Artillery Tank "Grad"')}</span><span class="campaign-roster-count">×1</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="after">
    <section class="menu-content page-briefing" aria-labelledby="campaign-regions-title">
      <h2 id="campaign-regions-title">{t("Campaign regions")}</h2>
      <p class="menu-lead">{t("The Iron Road spans 38 missions across seven European regions on 40×40 destructible arenas. Pursue the Iron Consortium convoy from Rome to Barcelona, earn credits for Garage upgrades, and defeat four Sector Bosses.")}</p>

      <div class="menu-grid campaign-regions-grid">
        <article class="menu-card">
          <strong>{t("1. Italy (Missions 1–5)")}</strong>
          <p>{t("Rome, Apennine Gorge, Milan, Lake Garda, and the Dolomites: urban ruins, mountain passes, and lakeside flanks.")}</p>
        </article>
        <article class="menu-card">
          <strong>{t("2. Alps (Missions 6–10)")}</strong>
          <p>{t("Neuschwanstein, Innsbruck, Hohensalzburg, Wachau, and Vienna: alpine castles, rail tunnels, and Danube river crossings.")}</p>
        </article>
        <article class="menu-card">
          <strong>{t("3. Bohemia & Saxony (Missions 11–15)")}</strong>
          <p>{t("Moravian Karst, Konopiště, Prague, Bohemian Forest, and Dresden: karst ravines and Elbe crossings guarded by Mammoth.")}</p>
        </article>
        <article class="menu-card">
          <strong>{t("4. Germany (Missions 16–21)")}</strong>
          <p>{t("Berlin, East Berlin rail yards, Harz Mountains, Remagen, and the Ruhr steelworks defended by Cerberus-T.")}</p>
        </article>
        <article class="menu-card">
          <strong>{t("5. Low Countries (Missions 22–26)")}</strong>
          <p>{t("Amsterdam, Rotterdam, Brussels, Antwerp, and the Scheldt Delta: canal rings, ports, and storm-surge dams held by Hydra.")}</p>
        </article>
        <article class="menu-card">
          <strong>{t("6. France (Missions 27–32)")}</strong>
          <p>{t("Paris, Versailles, Lyon, Mont Blanc, Provence, and Nice: grand boulevards, glaciers, and a Mammoth rematch on the Riviera.")}</p>
        </article>
        <article class="menu-card">
          <strong>{t("7. Pyrenees & Catalonia (Missions 33–38)")}</strong>
          <p>{t("Andorra, Bardenas Reales, Montserrat, and Barcelona: Pyrenean passes leading to the Port All-Boss Escalation and Titan.")}</p>
        </article>
      </div>

      <div class="menu-guide" style="margin-top:24px;">
        <section>
          <h3>{t("Three kinds of missions")}</h3>
          <p><strong>{t("Extermination")}</strong> {t("— destroy every hostile tank on the map, including the sector boss when one is present.")} <strong>{t("Stronghold Assault")}</strong> {t("— break through the defenses and destroy the fortified enemy stronghold core.")} <strong>{t("Base Defense")}</strong> {t("— hold off attacking waves while protecting your own Command Base HQ; losing either HQ cell ends the operation.")}</p>
        </section>
        <section>
          <h3>{t("Credits and upgrades between missions")}</h3>
          <p>{t("Earn credits on every cleared mission to upgrade Cannon, Chassis, Frame, Engine and Armor from Tier I to Tier V in the Garage, and equip standalone modules like 4-corner APS and homing ATGMs. Progress is saved in your browser.")}</p>
        </section>
      </div>

      <div class="menu-actions">
        <a class="menu-primary" href={h("./how-to-play")}>{t("How to Play →")}</a>
        <a class="menu-secondary" href={h("./campaign/walkthrough")}>{t("Campaign Walkthrough")}</a>
        <a class="menu-secondary" href={h("./enemies")}>{t("Enemy &amp; Boss Guide")}</a>
        <a class="menu-secondary" href={h("./arsenal")}>{t("Tank Arsenal &amp; Upgrades")}</a>
      </div>
    </section>
  </Fragment>

  <Fragment slot="noscript">
    <main style="max-width:720px;margin:48px auto;padding:24px;font-family:system-ui,sans-serif;color:#f8fafc;">
      <h1>{t("Tank Campaign: Road to the Capital — BATTLE TANK")}</h1>
      <p>{t("Select a mission on the Road to the Capital and deploy into 3D tactical tank combat. JavaScript and WebGL are required.")}</p>
    </main>
  </Fragment>
</PageLayout>
