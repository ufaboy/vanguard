---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("campaign");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Campaign",
        "item": "https://battletank.online/campaign"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="campaign"
  title={"Tank Campaign: 35 Base Defense Missions — BATTLE TANK"}
  description={"Play a 35-mission 3D tank campaign in your browser, no download. Defend your HQ like in Battle City, cross 7 regions and defeat 4 Sector Bosses."}
  ogDescription={"35 base defense and assault tank missions across 7 regions, ending in 4 Sector Boss fights. Free in your browser."}
  twitterDescription={"35 base defense tank missions across 7 regions in a free 3D Battle City-style browser game."}
  image={"https://battletank.online/images/campaign-map-clean.webp"}
  jsonLd={jsonLd}
  bodyPage="campaign"
  contentClass="menu-content campaign-content"
  script="src/pages/campaign.js"
