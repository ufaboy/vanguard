---
// Static page: English source text; translations come from i18n/pages/<locale>.mjs.
import PageLayout from '../../layouts/PageLayout.astro';
import { localHref, localeStaticPaths, useTranslations } from '../../i18n/index.js';

export const getStaticPaths = () => localeStaticPaths("arsenal");
const { locale } = Astro.props;
const t = useTranslations(locale);
const h = (href) => localHref(href, locale);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://battletank.online/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Tank Arsenal",
        "item": "https://battletank.online/arsenal"
      }
    ]
  }
];
---
<PageLayout
  locale={locale}
  slug="arsenal"
  title={"Tank Upgrades: 5-Tier Modular Arsenal — BATTLE TANK"}
  description={"Tank upgrade guide for BATTLE TANK: 5 components × 5 tiers, Cannon Mk1-Mk5 stats, all-terrain and hover chassis, directional armor, APS and homing ATGMs."}
  ogDescription={"5-track x 5-tier VANGUARD tank upgrades, Cannon Mk1-Mk5 specs, directional armor formula, 4-Corner APS, and field power-ups in BATTLE TANK."}
  twitterDescription={"Cannon Mk1-Mk5 damage &amp; penetration, CH4/CH5 water crossing, APS charge rules, and Garage upgrades."}
  image={"https://battletank.online/images/home-battle.webp"}
  jsonLd={jsonLd}
  bodyPage="arsenal"
  script="src/pages/how-to-play.js"
>
        <h1 class="menu-page-title" tabindex="-1">{t("Tank Upgrades &amp; Modular Arsenal")}</h1>
        <p class="menu-lead">
          {t("In BATTLE TANK, a")} <a href={h("./")}>{t("free 3D isometric tank game")}</a> {t("built around tank upgrades, your VANGUARD tank is engineered from a base hull (22 HP Tier-1 player hull) plus 5 core upgrade tracks (Tiers I–V) and standalone tactical modules. Press")} <strong>U</strong> {t("near your Command Base HQ during combat to open the Garage.")}
        </p>

        <h2 style="margin-top:32px;font-size:24px;font-weight:800;">{t("Main Cannon Line (Mk1 – Mk5)")}</h2>
        <figure class="menu-card" style="cursor:default;padding:14px;margin-top:16px;">
          <img src={h("./images/home-battle.webp")} alt={t("Upgraded VANGUARD tank firing in a 40x40 destructible urban arena, 3D isometric view")} loading="lazy" width="1280" height="720" style="width:100%;height:auto;border-radius:4px;display:block;">
          <figcaption style="margin-top:10px;color:#acbcbd;font-size:13px;">{t("Every Tier I–V upgrade across Cannon, Chassis, Frame, Engine, and Armor updates the live 3D tank model.")}</figcaption>
        </figure>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("TIER I // STANDARD")}</span>
            <strong>{t("Cannon Mk1 (I)")}</strong>
            <p><strong>{t("20 Damage · 0% Penetration · 1.50s Reload.")}</strong> {t("Reliable baseline tank gun for breaking brick walls and early patrols.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("TIER II // LASER RANGEFINDER")}</span>
            <strong>{t("Cannon Mk2 (II)")}</strong>
            <p><strong>{t("22 Damage · 10% Penetration · 1.25s Reload.")}</strong> {t("Higher muzzle velocity (9.5) and faster cycling against light armor.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("TIER III // AUTOLOADER")}</span>
            <strong>{t("Cannon Mk3 (III)")}</strong>
            <p><strong>{t("25 Damage · 22% Penetration · 1.20s Reload.")}</strong> {t("Thermal-shrouded barrel that punches through mid-tier reactive plating.")}</p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("TIER IV &amp; V // SIEGE &amp; TWIN-LINKED")}</span>
            <strong>{t("Cannon Mk4 (IV) &amp; Mk5 (V)")}</strong>
            <p><strong>{t("28 Damage · 32% Penetration · 1.00s Reload.")}</strong> {t("Heavy siege power that shatters 16 HP reinforced concrete. Mk5 fires a rapid twin-barrel double salvo.")}</p>
          </article>
        </div>

        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Chassis, Frame, Engine &amp; Armor Tracks")}</h2>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("MOBILITY // CH1 – CH5")}</span>
            <strong>{t("Chassis &amp; All-Terrain Crossings")}</strong>
            <p>
              {t("Progresses from 5-roadwheel steel tracks (CH1) and hydro-shock treads (CH2–CH3) to")} <strong>{t("CH4 All-Terrain Tracks")}</strong>
              {t("and")} <strong>{t("CH5 Grav-Hover")}</strong>{t("—both cross deep water and drive over ice, mud, and sand with zero slip or slowdown.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("STRUCTURE // F1 – F5")}</span>
            <strong>{t("Hull Frame &amp; Magazine Capacity")}</strong>
            <p>
              {t("Reinforces the hull from welded monocoque (F1) and bull-bar (F2) to composite exo-truss (F4) and Titan siege prow (F5), scaling cannon ammo capacity from 15 to 50 rounds as well as APS and ATGM magazine limits.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("PROPULSION // E1 – E5")}</span>
            <strong>{t("Engines &amp; Power-to-Weight")}</strong>
            <p>
              {t("Speed depends directly on total tank mass versus engine horsepower—from diesel louvers (E1), V8 turbo (E2), and V12 twin-intercooler (E3) up to a gas-turbine nacelle (E4) and twin-core fusion reactor (E5).")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("PROTECTION // A1 – A5")}</span>
            <strong>{t("Directional Armor &amp; Penetration")}</strong>
            <p>
              {t("Evolves from rolled steel (A1) and appliqué skirts (A2) to")} <em>{t("Kontakt-5")}</em> {t("ERA (A3),")} <em>{t("Chobham")}</em> {t("cheeks (A4), and")} <em>{t("Relikt")}</em> {t("citadel armor (A5). Effective Armor = Armor × (1 − Penetration / 100), evaluated per hit side (front, left, right, rear).")}
            </p>
          </article>
        </div>

        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Standalone Modules &amp; Field Power-Ups")}</h2>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("DEFENSE MODULE // APS_MODULE")}</span>
            <strong>{t("4-Corner Active Protection System")}</strong>
            <p>
              {t("Intercepts Cannon Mk1–Mk3 shells and all missiles for 1 charge each; heavy Cannon Mk4/Mk5, Howitzer, and Mammoth Dual shells cost 2 charges. Cannot intercept Flamethrower streams or Titan Rail slugs.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("OFFENSE &amp; SURVIVAL MODULES")}</span>
            <strong>{t("Homing ATGM Pod &amp; Auto-Repair Kit")}</strong>
            <p>
              <strong>{t("Homing ATGM Pod:")}</strong> {t("Launch guided anti-tank missiles with")} <code>{t("Space")}</code> {t("or")} <code>{t("Right Click")}</code> {t("— press")} <code>V</code> {t("to toggle the behind-the-missile FPV chase camera.")}<br>
              <strong>{t("Auto-Repair Kit:")}</strong> {t("Automatically restores +20 HP when hull integrity drops below 33%.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("BATTLEFIELD DROPS // BOX CACHES")}</span>
            <strong>{t("5 Tactical Field Power-Ups")}</strong>
            <p>
              {t("Break wooden BOX caches to roll")} <strong>{t("Repair")}</strong>, <strong>{t("EMP")}</strong> {t("(stuns hostiles),")} <strong>{t("Base Restore")}</strong> {t("(rebuilds destroyed HQ),")}
              <strong>{t("APS")}</strong> {t("charges, or")} <strong>{t("Missile")}</strong> {t("reloads—plus cannon ammo drops.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("HANGAR LOGISTICS")}</span>
            <strong>{t("Resupply &amp; Component Repairs")}</strong>
            <p>
              {t("Refill APS charges (1,000 credits) or ATGM missiles (3,000 credits) in the Hangar, and repair battle-damaged Tier II–V components (600 / 900 / 1,200 / 1,500 credits by tier).")}
            </p>
          </article>
        </div>

        <h2 style="margin-top:40px;font-size:24px;font-weight:800;">{t("Tactical Air Support")}</h2>
        <div class="menu-grid" style="margin-top:16px;">
          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("AIR STRIKE // KEY 5")}</span>
            <strong>{t("Bombs, Thermobaric &amp; AC-130 Spooky")}</strong>
            <p>
              {t("Choose from 3× Light Bombs ($3,000, ignites forest), Thermobaric Missile ($3,000, 3.5-cell fuel-air blast that melts ice to water and turns water to swamp), or AC-130 Spooky ($3,000, 15s orbit firing Cannon Mk2 shells).")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("AIR REPAIR // KEY 6 ($2,000)")}</span>
            <strong>{t("Quadrotor Repair Drone")}</strong>
            <p>
              {t("Dispatches an invulnerable repair drone from your base side that restores +20 HP over 3.5s, repairs all subsystems and armor panels, and clears critical component faults.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("AIR MINES &amp; DROP // KEYS 7 &amp; 8")}</span>
            <strong>{t("Carpet Air Mines &amp; Supply Air Drop")}</strong>
            <p>
              {t("Carpet Air Mines ($3,000) scatters 9 neutral mines across a 5×5 zone (detonating on occupied cells and sinking in water). Supply Air Drop ($2,000) delivers shells, APS, missiles, and a repair kit to your target.")}
            </p>
          </article>

          <article class="menu-card" style="cursor:default">
            <span class="menu-kicker">{t("RECON DRONE // KEY R ($1,200)")}</span>
            <strong>{t("Tactical Recon Drone")}</strong>
            <p>
              {t("One-time Hangar or HUD purchase ($1,200) that launches on Key R toward your cursor, orbiting in a 4-cell radius for 12s (25s cooldown) and revealing hidden, forest-concealed, and Stealth enemies within 6 cells—essential in Hard Mode.")}
            </p>
          </article>
        </div>

        <div class="menu-actions" style="margin-top:28px;">
          <a class="menu-primary" href={h("./campaign")}>{t("Launch Campaign →")}</a>
          <a class="menu-secondary" href={h("./enemies")}>{t("Enemy &amp; Boss Guide")}</a>
          <a class="menu-secondary" href={h("./how-to-play")}>{t("How to Play")}</a>
        </div>

  <Fragment slot="noscript">
      <main style="max-width:720px;margin:48px auto;padding:24px;font-family:system-ui,sans-serif;color:#f8fafc;">
        <h1>{t("Tank Upgrades: 5-Tier Modular Arsenal — BATTLE TANK")}</h1>
        <p>{t("Engineering guide to 5-track x 5-tier VANGUARD tank upgrades, standalone modules, and field power-ups in BATTLE TANK.")}</p>
      </main>
  </Fragment>
</PageLayout>
