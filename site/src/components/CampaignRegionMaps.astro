function createProjector(bounds) {
  const midLat = (bounds.minLat + bounds.maxLat) / 2;
  const cosLat = Math.cos((midLat * Math.PI) / 180);
  const geoW = (bounds.maxLon - bounds.minLon) * cosLat;
  const geoH = bounds.maxLat - bounds.minLat;
  const inner = SVG_SIZE - PAD * 2;
  const scale = Math.min(inner / geoW, inner / geoH);
  const offsetX = (SVG_SIZE - geoW * scale) / 2;
  const offsetY = (SVG_SIZE - geoH * scale) / 2;

  return (lon, lat, dx = 0, dy = 0) => ({
    x: Number((offsetX + (lon - bounds.minLon) * cosLat * scale + dx).toFixed(1)),
    y: Number((offsetY + (bounds.maxLat - lat) * scale + dy).toFixed(1)),
  });
}

function pointsToPath(points, project, close = true) {
  if (!points.length) return '';
  const coords = points.map(([lon, lat], i) => {
    const { x, y } = project(lon, lat);
    return `${i === 0 ? 'M' : 'L'}${x} ${y}`;
  });
  return close ? `${coords.join(' ')} Z` : coords.join(' ');
}

function buildGridLines(bounds, gridStep, project) {
  const verticals = [];
  const horizontals = [];
  const startLon = Math.ceil(bounds.minLon / gridStep) * gridStep;
  for (let lon = startLon; lon <= bounds.maxLon; lon += gridStep) {
    const p1 = project(lon, bounds.minLat);
    verticals.push({ x: p1.x, label: `${lon}°E`, showLabel: p1.x > 26 && p1.x < SVG_SIZE - 26 });
  }
  const startLat = Math.ceil(bounds.minLat / gridStep) * gridStep;
  for (let lat = startLat; lat <= bounds.maxLat; lat += gridStep) {
    const p1 = project(bounds.minLon, lat);
    horizontals.push({ y: p1.y, label: `${lat}°N`, showLabel: p1.y > 26 && p1.y < SVG_SIZE - 26 });
  }
  return { verticals, horizontals };
}

const maps = CAMPAIGN_CHAPTERS.map((chapter) => {
  const cfg = REGION_MAPS[chapter.id] || REGION_MAPS.italy;
  const project = createProjector(cfg.bounds);
  const grid = buildGridLines(cfg.bounds, cfg.gridStep || 2, project);
  const contextPaths = (cfg.contextPolygons || []).map((poly) => pointsToPath(poly, project, true));
  const countryPaths = (cfg.countryPolygons || []).map((poly) => pointsToPath(poly, project, true));
  const riverPaths = (cfg.rivers || []).map((river) => pointsToPath(river, project, false));
  const geoLabels = (cfg.geoLabels || []).map((lbl) => ({
    text: lbl.text,
    ...project(lbl.lon, lbl.lat),
  }));

  const markers = chapter.missions.map((mission) => {
    const geo = MISSION_GEO[mission.id] || {
      lon: (cfg.bounds.minLon + cfg.bounds.maxLon) / 2,
      lat: (cfg.bounds.minLat + cfg.bounds.maxLat) / 2,
      labelPos: 'top',
    };
    const pt = project(geo.lon, geo.lat, geo.dx || 0, geo.dy || 0);
    return {
      mission,
      num: String(mission.number).padStart(2, '0'),
      x: pt.x,
      y: pt.y,
      leftPct: ((pt.x / SVG_SIZE) * 100).toFixed(2),
      topPct: ((pt.y / SVG_SIZE) * 100).toFixed(2),
      labelPos: geo.labelPos || 'top',
    };
  });

  const routes = markers.slice(0, -1).map((curr, idx) => {
    const next = markers[idx + 1];
    return {
      from: curr.mission.id,
      to: next.mission.id,
      x1: curr.x,
      y1: curr.y,
      x2: next.x,
      y2: next.y,
    };
  });

  return {
    chapter,
    firstNum: markers[0]?.num || '01',
    lastNum: markers[markers.length - 1]?.num || '01',
    grid,
    contextPaths,
    countryPaths,
    riverPaths,
    geoLabels,
    routes,
    markers,
  };
});
