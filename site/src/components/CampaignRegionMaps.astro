{maps.map((mapData, chIdx) => {
  const isDefault = chIdx === 0;
  return (
    <div
      class="campaign-region-map-card"
      data-region-map={mapData.chapter.id}
      style={`--region-accent:${mapData.chapter.color};`}
      hidden={!isDefault}
    >
      <div class="region-map-hud-top">
        <span class="recon-hud-pill" data-map-region-name>{mapData.chapter.name.toUpperCase()}</span>
        <span class="recon-hud-pill">{mapData.firstNum}–{mapData.lastNum}</span>
      </div>
      <svg class="region-map-svg" viewBox={`0 0 ${SVG_SIZE} ${SVG_SIZE}`} aria-hidden="true">
        <rect x="0" y="0" width={SVG_SIZE} height={SVG_SIZE} class="region-map-sea" />
        {mapData.grid.verticals.map((v) => (
          <>
            <line x1={v.x} y1="0" x2={v.x} y2={SVG_SIZE} class="region-map-grid-line" />
            {v.showLabel && <text x={v.x} y={SVG_SIZE - 8} text-anchor="middle" class="region-map-grid-label">{v.label}</text>}
          </>
        ))}
        {mapData.grid.horizontals.map((h) => (
          <>
            <line x1="0" y1={h.y} x2={SVG_SIZE} y2={h.y} class="region-map-grid-line" />
            {h.showLabel && <text x="8" y={h.y - 4} class="region-map-grid-label">{h.label}</text>}
          </>
        ))}
        {mapData.contextPaths.map((d) => (
          <path d={d} class="region-map-context-land" />
        ))}
        {mapData.countryPaths.map((d) => (
          <path d={d} class="region-map-active-land" />
        ))}
        {mapData.riverPaths.map((d) => (
          <path d={d} class="region-map-river" />
        ))}
        {mapData.geoLabels.map((lbl) => (
          <text x={lbl.x} y={lbl.y} text-anchor="middle" class="region-map-geo-label">{lbl.text}</text>
        ))}
        {mapData.routes.map((r, rIdx) => (
          <line
            x1={r.x1}
            y1={r.y1}
            x2={r.x2}
            y2={r.y2}
            data-route-from={r.from}
            data-route-to={r.to}
            class={`region-map-route ${isDefault && rIdx === 0 ? 'is-locked' : 'is-locked'}`}
          />
        ))}
      </svg>
      <div class="region-map-markers">
        {mapData.markers.map((m, mIdx) => {
          const initialStatus = isDefault && mIdx === 0 ? 'available' : 'locked';
          const isInitialSelected = isDefault && mIdx === 0;
          return (
            <button
              type="button"
              class={`region-map-marker is-${initialStatus}${isInitialSelected ? ' is-selected' : ''} label-${m.labelPos}`}
              style={`left:${m.leftPct}%;top:${m.topPct}%;`}
              data-action="select-campaign-mission"
              data-mission={m.mission.id}
              aria-pressed={isInitialSelected ? 'true' : 'false'}
              aria-label={`Mission ${m.mission.number}: ${m.mission.name}. ${initialStatus}.`}
            >
              <span class="marker-pulse" aria-hidden="true"></span>
              <span class="marker-reticle" aria-hidden="true"></span>
              <span class="marker-node">
                <svg class="marker-icon marker-icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                <svg class="marker-icon marker-icon-lock" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17 10h-1V7a4 4 0 0 0-8 0v3H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-3a2 2 0 1 1 4 0v3h-4V7z" /></svg>
                <span class="marker-core" aria-hidden="true"></span>
              </span>
              <span class="marker-num">{m.num}</span>
              <span class="region-map-tooltip" role="tooltip">{m.num} · {m.mission.name}</span>
            </button>
          );
        })}
      </div>
      <div class="region-map-hud-bottom">
        <span class="region-map-selected-pill">{mapData.markers[0]?.num} · {mapData.markers[0]?.mission.name}</span>
      </div>
    </div>
  );
})}
